---
/** Contact: email, postal address, the phone line and recordings by mail. */
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import { ASIDES, CONTACT, EXTERNAL } from "../lib/content.ts";
---
<Base
  title="Contact"
  description={'Contact Congregation Emunas Yisrael about the Mashgiach, Harav Moshe Wolfson zt"l, his shiurim and sefarim, and recordings by mail.'}
>
  <div class="wrap">
    <PageHead title="Contact" label="Contact" labelAside={ASIDES.contact} />
    <div class="page-body page-grid">
      <div class="prose">
        <p>For more information about the Mashgiach and his teaching, email
        <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>.</p>
        <h2 id="recordings">Recordings by mail</h2>
        <p>Those who wish can have audio shiurim sent by mail. Email us or write to the address on this page.</p>
        <h2>The shiurim by phone</h2>
        <p>Call <a href={CONTACT.phoneHref}>{CONTACT.phone}</a> to hear the shiurim. Audio shiurim in English and
        Yiddish are also on <a href={EXTERNAL.torahAnytime}>TorahAnytime</a>.</p>
      </div>
      <aside>
        <div class="card">
          <h2>By mail</h2>
          <address>{CONTACT.address.map((line, i) => <>{line}{i < CONTACT.address.length - 1 && <br />}</>)}</address>
        </div>
        <div class="card">
          <h2>By email</h2>
          <p><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></p>
        </div>
      </aside>
    </div>
  </div>
</Base>
