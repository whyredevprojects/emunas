---
/** Sign-up for the weekly Devar Torah by email (an external Brevo form). */
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import { EXTERNAL } from "../lib/content.ts";
---
<Base
  title="Weekly Devar Torah"
  description={'Free weekly divrei Torah from the Mashgiach, Harav Moshe Wolfson zt"l, by email, with news of new English sefarim.'}
>
  <div class="wrap">
    <PageHead title="Weekly Devar Torah" label="By email" labelYi="דבר תורה" />
    <div class="page-body prose">
      <p>Sign up for free weekly divrei Torah from the Mashgiach, Harav Moshe Wolfson zt"l. You will also receive
      emails with updates about new English sefarim.</p>
      <p><a class="button" href={EXTERNAL.devarTorah}>Sign up by email</a></p>
      <p class="meta">The sign-up form is run by Brevo, an email service, and opens on its site.</p>
    </div>
  </div>
</Base>
