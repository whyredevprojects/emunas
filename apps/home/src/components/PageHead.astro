---
/** Breadcrumb and title block of an interior page. */
interface Props {
  title: string;
  label: string;
  intro?: string;
}

const { title, label, intro } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol><li><a href="/">Home</a></li><li aria-current="page">{title}</li></ol>
</nav>
<div class="page-head">
  <span class="label">{label}</span>
  <h1>{title}</h1>
  {intro && <p class="intro">{intro}</p>}
</div>
