---
/** Breadcrumb and title block of an interior page. */
interface Props {
  title: string;
  label: string;
  /** Short Yiddish label next to the English one. */
  labelYi?: string;
  intro?: string;
}

const { title, label, labelYi, intro } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol><li><a href="/">Home</a></li><li aria-current="page">{title}</li></ol>
</nav>
<div class="page-head">
  <span class="label">{label}{labelYi && <> &middot; <span lang="yi" dir="rtl">{labelYi}</span></>}</span>
  <h1>{title}</h1>
  {intro && <p class="intro">{intro}</p>}
  <slot />
</div>
