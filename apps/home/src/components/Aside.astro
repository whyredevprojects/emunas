---
/**
 * A phrase in every aside language (lib/langs.ts: Yiddish, Hebrew, …) beside the English it goes
 * with, each with its own lang and dir. `inline` (default) runs them in one span separated by
 * middots; `block` gives each language its own element (`as`), so the first can be styled as the
 * main line and the rest (`.x + .x`) as smaller lines beneath it.
 */
import { asideTexts, type Asides } from "../lib/langs.ts";

interface Props {
  text: Asides;
  layout?: "inline" | "block";
  /** Element of each line in `block` layout. */
  as?: "span" | "p";
  class?: string;
}

const { text, layout = "inline", as = "span", class: cls } = Astro.props;
const items = asideTexts(text);
const Tag = as;
---
{layout === "inline" ? (
  <span class={cls}>{items.map((a, i) => <>{i > 0 && <> &middot; </>}<span lang={a.lang} dir={a.dir}>{a.text}</span></>)}</span>
) : (
  items.map((a) => <Tag class={cls} lang={a.lang} dir={a.dir}>{a.text}</Tag>)
)}
