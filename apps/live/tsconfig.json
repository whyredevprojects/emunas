{
  "extends": "@emunas/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    ".react-router/types/**/*",
    "react-router.config.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["build", "node_modules"]
}
