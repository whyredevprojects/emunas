---
/**
 * Base layout for every edition page (concept-quiet §4, §8, §11; tech-quiet §4):
 * - `<html lang dir>` per edition (yi → rtl, en → ltr);
 * - skip link, the one-line nav (Contents · Calendar · Indexes · Search · About) and the edition
 *   switch, which goes to the same path in the other edition and keeps the hash;
 * - the light/dark switch, a sun and a moon (lib/theme.client.ts; hidden until script shows it). Light is the
 *   default; components/ThemeHead.astro applies a dark choice before paint;
 * - optional breadcrumb that mirrors the catalog;
 * - `main#main`, footer (its last line is the dedication), and the print layer (styles/print.css: nav, switches and player hidden).
 *
 * Slots: default (page body), `head` (extra head tags). Canonical, hreflang, OG and robots come
 * from components/seo/Seo.astro (W4.6).
 */
import "../styles/fonts.css";
import "@emunas/tokens/tokens.css";
import "../styles/quiet.css";
import "../styles/print.css";
import { scriptOf } from "@emunas/i18n";
import { formatQuiet } from "@emunas/links";
import { isolateText } from "../lib/bidi.ts";
import { dirOf, otherEdition, switchEdition, type Ed } from "../lib/edition.ts";
import { fontPreloads } from "../lib/fonts.ts";
import { navItems, navSectionOf, type Crumb } from "../lib/nav.ts";
import { useT } from "../i18n/index.ts";
import Seo from "../components/seo/Seo.astro";
import Dedication from "../components/Dedication.astro";
import ThemeHead from "../components/ThemeHead.astro";

interface Props {
  ed: Ed;
  /** Page title, without the site name. Catalog titles are isolated automatically. */
  title: string;
  /** Root-relative path of this page (default: `Astro.url.pathname`). */
  path?: string;
  crumbs?: readonly Crumb[];
  description?: string;
  noindex?: boolean;
}

const { ed, title, crumbs, description, noindex = false } = Astro.props;
const path = Astro.props.path ?? Astro.url.pathname;
const t = useT(ed);
const dir = dirOf(ed);
const other = otherEdition(ed);
const switchHref = switchEdition(path, other);
const current = navSectionOf(path);
const home = formatQuiet({ kind: "home", ed });
const editionScript = ed === "yi" ? "he" : "latin";
const titleText = scriptOf(title) === editionScript ? title : isolateText(title);
const fullTitle = path === home ? t("site.name") : `${titleText} · ${t("site.name")}`;
const otherDir = dirOf(other);
---
<!doctype html>
<html lang={ed} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <ThemeHead />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? t("site.description")} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {fontPreloads(ed).map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <Seo
      path={path}
      title={path === home ? t("site.name") : title}
      description={description ?? t("site.description")}
      siteName={t("site.name")}
      noindex={noindex}
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t("skip.toMain")}</a>
    <header class="site-header">
      <p class="site-name"><a href={home} aria-current={path === home ? "page" : undefined}>{t("site.name")}</a></p>
      <nav class="site-nav" aria-label={t("nav.label")}>
        <ul role="list">
          {navItems(ed).map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.href === path ? "page" : current === item.id ? "true" : undefined}
              >{t(item.key)}</a>
            </li>
          ))}
        </ul>
      </nav>
      <p class="edition-switch">
        <span class="visually-hidden">{t("edition.label")}: </span>
        <a href={switchHref} hreflang={other} lang={other} dir={otherDir} data-edition-switch>{t("edition.other")}</a>
      </p>
      <div class="theme-switch" role="group" aria-label={t("theme.label")} hidden data-theme-switch>
        <button type="button" data-theme-value="light" aria-pressed="true" aria-label={t("theme.light")} title={t("theme.light")}>
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="4.5" fill="currentColor" />
            <path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.58 4.58l2.12 2.12M17.3 17.3l2.12 2.12M4.58 19.42l2.12-2.12M17.3 6.7l2.12-2.12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </button>
        <button type="button" data-theme-value="dark" aria-pressed="false" aria-label={t("theme.dark")} title={t("theme.dark")}>
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
            <path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.39 5.39 0 0 1-4.4 2.26 5.4 5.4 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z" fill="currentColor" />
          </svg>
        </button>
      </div>
    </header>
    {crumbs && crumbs.length > 0 && (
      <nav class="breadcrumb" aria-label={t("breadcrumb.label")}>
        <ol role="list">
          {crumbs.map((c, i) => (
            <li>
              {c.href && i < crumbs.length - 1 ? (
                <a href={c.href}><bdi lang={c.lang} dir={c.dir}>{c.label}</bdi></a>
              ) : (
                <span aria-current="page"><bdi lang={c.lang} dir={c.dir}>{c.label}</bdi></span>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <p>{t("footer.recordingIsSource")}</p>
      <p class="footer-links">
        <a href={formatQuiet({ kind: "index", ed, index: "about" })}>{t("nav.about")}</a>
        <span aria-hidden="true"> · </span>
        <a href={switchHref} hreflang={other} data-edition-switch>{t("footer.otherEdition")}</a>
      </p>
      <p class="print-only print-source"><bdi dir="ltr">{path}</bdi></p>
      <Dedication />
    </footer>
    <script>
      import { keepPlace } from "../lib/edition-switch.client.ts";
      import { themeSwitch } from "../lib/theme.client.ts";
      keepPlace(document, location, window);
      themeSwitch(document, location, window);
    </script>
  </body>
</html>
