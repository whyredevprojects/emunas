---
/**
 * Catalog header, the human voice (concept-quiet §5.4 part 1, tech-quiet §4):
 * - the title exactly as catalogued (`titleOriginal`), never translated, as a `<bdi>` with
 *   `lang`/`dir` from its dominant script (mixed titles keep their punctuation in place);
 * - a library-card citation line: section · parsha/zman · perek · no. · guide page · year ·
 *   spoken language · length;
 * - `pathNotes` as plain notes, and one sentence when the row is not a printed guide entry.
 */
import { formatDuration, languageName } from "@emunas/i18n";
import HebrewYear from "./HebrewYear.astro";
import { runAttrs } from "../lib/bidi.ts";
import { catalogNotice, type CatalogHeaderShiur } from "../lib/catalog.ts";
import type { Ed } from "../lib/edition.ts";
import { useT } from "../i18n/index.ts";

interface Props {
  ed: Ed;
  shiur: CatalogHeaderShiur;
  /** Link for the section name in the citation line (the section page). */
  sectionHref?: string;
  /** Heading level of the title. Default 1 (the shiur page). */
  level?: 1 | 2 | 3;
}

const { ed, shiur, sectionHref, level = 1 } = Astro.props;
const t = useT(ed);
const c = shiur.catalog;
const run = (text: string) => runAttrs(text, shiur.lang);
const occasion = shiur.parsha?.raw ?? shiur.zman?.raw ?? null;
const derivedNotice = catalogNotice(c, ed);
const duration = formatDuration(shiur.duration, ed);
const Title = `h${level}` as "h1" | "h2" | "h3";
const titleId = `title-${shiur.id}`;
---
<header class="catalog-header voice-catalog" aria-labelledby={titleId}>
  {c.heading && (
    <p class="catalog-heading"><bdi {...run(c.heading)}>{c.heading}</bdi></p>
  )}
  <Title class="catalog-title" id={titleId}><bdi {...run(c.titleOriginal)}>{c.titleOriginal}</bdi></Title>
  {c.subTitle && (
    <p class="catalog-subtitle"><bdi {...run(c.subTitle)}>{c.subTitle}</bdi></p>
  )}
  <p class="citation">
    <span class="visually-hidden">{t("citation.label")}: </span>
    <span class="cite-item">{sectionHref ? (
      <a href={sectionHref}><bdi {...run(c.sectionTitle)}>{c.sectionTitle}</bdi></a>
    ) : (
      <bdi {...run(c.sectionTitle)}>{c.sectionTitle}</bdi>
    )}</span>
    {occasion && <span class="cite-item"><bdi {...run(occasion)}>{occasion}</bdi></span>}
    {shiur.perek && <span class="cite-item"><bdi {...run(shiur.perek)}>{shiur.perek}</bdi></span>}
    {c.n && <span class="cite-item">{t("citation.number", { n: "⁨" + c.n + "⁩" })}</span>}
    {c.page !== null && <span class="cite-item">{t("citation.guidePage", { page: c.page })}</span>}
    {shiur.years.length > 0 && <span class="cite-item"><HebrewYear year={shiur.years} /></span>}
    <span class="cite-item">{languageName(shiur.lang, ed)}</span>
    {duration && <span class="cite-item">{duration}</span>}
  </p>
  {shiur.pathNotes.map((note) => (
    <p class="path-note"><bdi {...run(note)}>{note}</bdi></p>
  ))}
  {derivedNotice && <p class="catalog-notice">{derivedNotice}</p>}
</header>
