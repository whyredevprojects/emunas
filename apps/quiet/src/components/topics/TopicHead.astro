---
/**
 * The head of a topic page (C4.1 parts 1, 2 and 6): the Hebrew headword (English beside it in the
 * English edition), the count, the place in the tree and the "see also" line (shared EntryHead);
 * under it the glossary definition when a concept shares the topic's subject (one inyan, one main
 * entry), the generated description as notes (left out when there is none), and, for a topic
 * linked to the calendar, its days and the one-line rule.
 */
import { corpusLabel } from "@emunas/i18n";
import EntryHead from "../corpus/EntryHead.astro";
import type { Ed } from "../../lib/edition.ts";
import CalendarRule from "./CalendarRule.astro";
import TopicName from "./TopicName.astro";
import type { TopicPage } from "./model.ts";
import { useTopicsT } from "./strings.ts";
import { langAttrsIn, occasionNameAttrs } from "../../lib/content.ts";
import "./topics.css";

interface Props {
  ed: Ed;
  page: TopicPage;
  /** Extra line under the headword (the continuation page says "all the shiurim"). */
  meta?: string;
  /** Print the description, definition and calendar line (the continuation page leaves them out). */
  notes?: boolean;
}

const { ed, page, meta, notes = true } = Astro.props;
const t = useTopicsT(ed);
const count = t("count.shiurim", { count: page.count });
---
<EntryHead ed={ed} title={page.name.title} alt={page.name.alt} meta={meta ? `${meta} · ${count}` : count} seeAlso={notes ? page.seeAlso : []}>
  {page.path.length > 0 && (
    <p class="entry-meta topic-place">
      {t("topic.place")}:{" "}
      {page.path.map((a) => (
        <>{a.href ? <a href={a.href}><TopicName name={a.name} /></a> : <TopicName name={a.name} />}<span aria-hidden="true"> › </span></>
      ))}
      <TopicName name={page.name} />
    </p>
  )}
</EntryHead>
{notes && (page.definition || page.description) && (
  <div class="voice-notes topic-notes">
    {page.definition && (
      <p class="topic-definition" data-definition><span class="visually-hidden">{corpusLabel("glossary.asUsed", ed)}: </span><span {...langAttrsIn(page.definition, ed)}>{page.definition.text}</span></p>
    )}
    {page.description && <p class="topic-description" data-description {...langAttrsIn(page.description, ed)}>{page.description.text}</p>}
  </div>
)}
{notes && page.occasions.length > 0 && (
  <div class="topic-calendar">
    <p class="topic-occasions">
      {t("topic.calendar")}:{" "}
      {page.occasions.map((o, i) => (
        <>{i > 0 && <span aria-hidden="true"> · </span>}<a href={o.href}><bdi {...occasionNameAttrs(ed)}>{o.name}</bdi></a></>
      ))}
    </p>
    <CalendarRule ed={ed} />
  </div>
)}
