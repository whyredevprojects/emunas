---
/**
 * The head of every AI index page (concept-quiet §5.7–5.10, §10): the heading, a one-line
 * description, the coverage line ("Compiled from the N shiurim that have notes so far, of 997"),
 * the standing notes label and the "partial and unreviewed" notice. Entity pages pass `alt` (the
 * name in the other script) and `meta` (counts).
 */
import type { BuildCounts } from "@emunas/corpus/public";
import Coverage from "../Coverage.astro";
import NotesLabel from "../NotesLabel.astro";
import type { Ed } from "../../lib/edition.ts";
import type { Run } from "./model.ts";
import { useIndexesT } from "./strings.ts";
import "./indexes.css";

interface Props {
  ed: Ed;
  title: Run;
  alt?: Run | null;
  intro?: string | null;
  meta?: string | null;
  counts: BuildCounts;
}

const { ed, title, alt = null, intro = null, meta = null, counts } = Astro.props;
const t = useIndexesT(ed);
---
<header class="index-head">
  <h1><bdi lang={title.lang} dir={title.dir}>{title.text}</bdi>{alt && <> <span class="alt-name"><bdi lang={alt.lang} dir={alt.dir}>{alt.text}</bdi></span></>}</h1>
  {meta && <p class="index-meta">{meta}</p>}
  {intro && <p class="index-intro">{intro}</p>}
  <Coverage ed={ed} withNotes={counts.full} total={counts.total} />
  <NotesLabel ed={ed} />
  <p class="index-partial">{t("index.partial")}</p>
</header>
