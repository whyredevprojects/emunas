---
/**
 * A story title on an index (AI notes, in the edition's language) linking to its shiur at the
 * story's time. No retelling: that stays on the shiur page (concept-quiet §5.8). With `cite`, the
 * shiur's citation follows the title.
 */
import { clock } from "../../lib/bidi.ts";
import type { Ed } from "../../lib/edition.ts";
import CiteLink from "./CiteLink.astro";
import type { StoryLine } from "./model.ts";

interface Props {
  ed: Ed;
  story: StoryLine;
  /** Show the shiur's citation after the title (stories index). */
  cite?: boolean;
}

const { ed, story, cite = false } = Astro.props;
const time = story.cite.t !== null ? clock(story.cite.t) : null;
---
{cite ? (
  <><span class="story-title" lang={ed}>{story.title}</span>{" "}<span class="cites"><CiteLink ed={ed} cite={story.cite} /></span></>
) : (
  <a class="story-title" href={story.cite.href} lang={ed}>{story.title}{time && <> <span class="time"><bdi dir="ltr">{time}</bdi></span></>}</a>
)}
