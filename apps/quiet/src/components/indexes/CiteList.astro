---
/** Citations run on in one line, as in a printed index (`נח no. 5 תשמ"ג 12:34; …`). */
import type { Ed } from "../../lib/edition.ts";
import CiteLink from "./CiteLink.astro";
import type { Cite } from "./model.ts";

interface Props {
  ed: Ed;
  cites: readonly Cite[];
}

const { ed, cites } = Astro.props;
---
{cites.length > 0 && (
  <ul class="cites" role="list">
    {cites.map((cite) => <li><CiteLink ed={ed} cite={cite} /></li>)}
  </ul>
)}
