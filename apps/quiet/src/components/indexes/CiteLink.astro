---
/**
 * One pointer into a shiur on an index page: the shiur's title (the link, to the shiur page at
 * that moment: `#t=` global seconds or `#s{idx}`, with the time beside it), then when it was said:
 * the parsha or zman as catalogued and the Hebrew year, and the shiur's language when it differs
 * from the edition. The title and occasion are catalog text, so each is an isolate.
 */
import { formatHebrewYears, languageName } from "@emunas/i18n";
import { clock } from "../../lib/bidi.ts";
import type { Ed } from "../../lib/edition.ts";
import type { Cite } from "./model.ts";

interface Props {
  ed: Ed;
  cite: Cite;
}

const { ed, cite } = Astro.props;
const years = cite.years.length > 0 ? formatHebrewYears(cite.years, ed, { civil: false }) : null;
const lang = cite.lang !== ed ? languageName(cite.lang, ed) : null;
const time = cite.t !== null ? clock(cite.t) : null;
const meta = cite.occasion !== null || years !== null || lang !== null;
---
<a class="cite" href={cite.href}><bdi lang={cite.title.lang} dir={cite.title.dir}>{cite.title.text}</bdi>{time && <> <span class="time"><bdi dir="ltr">{time}</bdi></span></>}</a>{meta && <span class="cite-meta">{cite.occasion && <>{" · "}<bdi lang={cite.occasion.lang} dir={cite.occasion.dir}>{cite.occasion.text}</bdi></>}{years && <>{" · "}<bdi lang="he" dir="rtl">{years}</bdi></>}{lang && <> <span class="cite-lang">({lang})</span></>}</span>}
