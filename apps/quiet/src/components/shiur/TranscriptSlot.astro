---
/**
 * The reserved "Follow the text" slot (concept-quiet §5.4, §9; integration-plan §0.3, C17).
 *
 * Designed but switched off: a recording's text can appear here only when the recording is
 * eligible in `site-policy/transcript-eligibility.json` AND the build flag EMUNAS_TRANSCRIPT_VIEW is
 * on (W5.2, `FollowText.astro`). With the defaults this renders nothing, and nothing on the page
 * mentions the slot.
 */
import type { PublicRecording } from "@emunas/corpus/public";
import FollowText from "./FollowText.astro";

interface Props {
  recordings: readonly PublicRecording[];
}

const ed = Astro.params["ed"] === "yi" ? "yi" : "en";
---
<FollowText recordings={Astro.props.recordings} ed={ed} />
