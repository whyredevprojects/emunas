---
/**
 * "Follow the text" (concept-quiet §5.4, §9; integration-plan §0.3, C17, §4; W5.2). Designed, OFF.
 *
 * Renders only when ALL hold at build time:
 *   - EMUNAS_TRANSCRIPT_VIEW=on (default off);
 *   - corpus:build wrote `.corpus/transcript/<recordingId>.json` for the recording (the transcript gate
 *     approved it: an entry in site-policy/transcript-eligibility.json with the current identity);
 *   - `readPublishedTranscripts` still accepts that file (flag, entry and identity version re-checked).
 * Otherwise it renders nothing at all: no markup, no script, no mention of the slot.
 *
 * The words are never in the page HTML. The page carries only a pointer to the public file
 * `/transcript/<recordingId>.json` (emitted by `src/pages/transcript/[rec].json.ts` for the same
 * recordings), and a small script fetches and lists it with time links the player already handles
 * (`a.time[data-g]`, global seconds). That keeps the guard's verbatim scan meaningful for every page:
 * the post-pass accepts the eligible transcript files and nothing else.
 *
 * The script is `/transcript/follow-text.js`, written by `src/pages/transcript/[script].js.ts` only
 * when at least one file is published. It is deliberately not an Astro-processed `<script>` here:
 * Astro bundles a component's script into `_astro/` whenever the component is imported, rendered
 * or not, and with the view off no part of it may ship. `is:inline` only means "do not bundle"; the
 * tag is an external same-origin module, so the CSP (`script-src 'self'`) holds.
 */
import type { PublicRecording } from "@emunas/corpus/public";
import { readPublishedTranscripts } from "@emunas/corpus/transcript-gate";
import { findCorpusDir } from "./corpus.ts";
import { FOLLOW_TEXT } from "./follow-text-strings.ts";
import type { Ed } from "../../lib/edition.ts";

interface Props {
  recordings: readonly PublicRecording[];
  ed: Ed;
}

const { recordings, ed } = Astro.props;
const corpusDir = findCorpusDir();
const published = corpusDir ? readPublishedTranscripts(corpusDir) : new Map();
const shown = recordings.filter((r) => published.has(r.id));
const multi = recordings.length > 1;

const c = FOLLOW_TEXT[ed];
---
{shown.length > 0 && (
  <section class="follow-text" id="follow-text" aria-labelledby="follow-text-heading" data-print="hide" data-follow-text data-loading={c.loading} data-failed={c.failed}>
    <h2 id="follow-text-heading">{c.heading}</h2>
    <p class="follow-text-note">{c.note}</p>
    {shown.map((r) => (
      <div class="follow-text-rec" data-follow-src={`/transcript/${r.id}.json`} data-rec={r.id} data-offset={r.offset} data-audio={r.audioUrl ?? ""} lang={published.get(r.id)?.lang ?? undefined}>
        {multi && <h3>{c.part(r.order + 1)}</h3>}
        <p><a href={`/transcript/${r.id}.json`}>{c.open}</a></p>
      </div>
    ))}
  </section>
)}
{shown.length > 0 && <script type="module" src="/transcript/follow-text.js" is:inline></script>}
