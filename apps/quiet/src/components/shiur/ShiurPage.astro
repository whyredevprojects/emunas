---
/**
 * The shiur page (concept-quiet §5.4; tech-quiet §4, §7), the page the site exists for.
 *
 * Full page (status "full"): catalog header (title and one meta line) · listen · "open in the
 * listening app" · the notes area under its single standing AI label (about this shiur, with one
 * line of ענינים from the corpus layer: concept-quiet-corpus C4.8, `refs.ts`) · previous and next ·
 * report an error.
 *
 * Catalog-only page: the same without the notes area, which is one sentence instead ("Notes for
 * this shiur have not been prepared yet."). No skeletons, no placeholders.
 *
 * Works without script: every recording is a native `<audio>` (the
 * AI-improved copy where there is one; Listen's version line switches). With script (`scripts/player.ts`)
 * the playing recording docks, and `#t=<global seconds>` in the address (the deep links from the
 * topic, story and index pages) seeks there.
 *
 * Input is the public contract only (`PublicShiur`; integration-plan §5.2): no transcript field
 * exists to render.
 */
import { notice } from "@emunas/i18n";
import type { LayerShiurRefs, PublicShiur } from "@emunas/corpus/public";
import Base from "../../layouts/Base.astro";
import CatalogHeader from "../CatalogHeader.astro";
import Listen from "../Listen.astro";
import NotesLabel from "../NotesLabel.astro";
import { formatQuiet } from "@emunas/links";
import { runAttrs } from "../../lib/bidi.ts";
import type { Crumb } from "../../lib/nav.ts";
import { langAttrsIn, shownText } from "../../lib/content.ts";
import type { Ed } from "../../lib/edition.ts";
import { useT } from "../../i18n/index.ts";
import PrevNext from "./PrevNext.astro";
import TopicLine from "./TopicLine.astro";
import { useShiurT } from "./strings.ts";
import { topicLine, type ShiurLayer } from "./refs.ts";
import { sectionHref, sectionTitle, type PrevNextView } from "./view.ts";
import "./shiur.css";

interface Props {
  ed: Ed;
  shiur: PublicShiur;
  /** Previous and next in the series or the section; null when the aggregate has none. */
  prevNext: PrevNextView | null;
  /** The corpus layer's entity records and page flags (`.corpus/layer/`). */
  layer?: ShiurLayer;
  /** The shiur's layer refs (`.corpus/layer/shiur/<id>.json`); null when it is not in the visible set. */
  refs?: LayerShiurRefs | null;
  /** Absolute URL of the same shiur in the listening app (`@emunas/links`), or null when hosts are not configured. */
  liveHref?: string | null;
  /** `mailto:` link that pre-fills the shiur id, or null when no address is configured. */
  reportHref?: string | null;
}

const { ed, shiur, prevNext, layer, refs = null, liveHref = null, reportHref = null } = Astro.props;
const t = useShiurT(ed);
const ui = useT(ed);
const c = shiur.catalog;
const notes = shiur.status === "full" ? shiur.notes : undefined;
// Only a shiur with notes is in the visible set; a catalog-only page shows no corpus line.
const shiurRefs = notes && layer ? refs : null;
const topics = layer && shiurRefs ? topicLine(ed, layer, shiurRefs) : [];
const section = sectionHref(ed, c);
const sectionName = sectionTitle(ed, c);
// The last crumb is always the title (cut short by CSS only, so the full text stays readable).
const crumbs: Crumb[] = [
  { label: ui("nav.contents"), href: formatQuiet({ kind: "index", ed, index: "contents" }) },
  { label: sectionName, href: section, ...runAttrs(sectionName, shiur.lang, ed) },
  { label: c.titleOriginal, ...runAttrs(c.titleOriginal, shiur.lang, ed) },
];
// Generated text: the edition's language, else the fallback, each with its own lang/dir.
const oneLiner = shownText(notes?.summary.oneLiner, ed);
const abstract = shownText(notes?.summary.abstract, ed);
const description = oneLiner?.text;
const path = formatQuiet({ kind: "shiur", ed, id: shiur.id }, {}, { bare: true });
---
<Base ed={ed} title={c.titleOriginal} path={path} crumbs={crumbs} {...(description ? { description } : {})}>
  <article
    class="shiur"
    data-shiur={shiur.id}
    data-player-title={c.titleOriginal}
    data-player-artist={ui("site.name")}
    data-player-album={sectionName}
  >
    <CatalogHeader ed={ed} shiur={shiur} />
    <Listen ed={ed} recordings={shiur.recordings} />
    {liveHref && (
      <p class="open-live" data-print="hide"><a href={liveHref} hreflang={ed}>{t("live.open")}</a></p>
    )}
    {notes ? (
      <div class="voice-notes" lang={ed}>
        <NotesLabel ed={ed} />
        <section class="about-shiur" id="about" aria-labelledby="about-heading">
          <h2 id="about-heading">{t("about.heading")}</h2>
          {oneLiner && <p class="one-liner" {...langAttrsIn(oneLiner, ed)}>{oneLiner.text}</p>}
          {abstract && <p class="abstract" {...langAttrsIn(abstract, ed)}>{abstract.text}</p>}
          <TopicLine ed={ed} topics={topics} />
        </section>
      </div>
    ) : (
      <p class="notes-pending" lang={ed}>{notice("notesPending", ed)}</p>
    )}
    {prevNext && <PrevNext ed={ed} view={prevNext} shiurLang={shiur.lang} />}
    {reportHref && (
      <p class="report-error" data-print="hide"><a href={reportHref}>{t("report.link")}</a></p>
    )}
  </article>
  <script>
    import { initPlayer } from "../../scripts/player.ts";
    initPlayer(document, window);
  </script>
</Base>
