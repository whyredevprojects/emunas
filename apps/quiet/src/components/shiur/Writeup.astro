---
/**
 * The write-up, the main text of the page (concept-quiet §5.4 part 5): `writeup[ed]` in section
 * order with each block's heading, one measured column. In the margin beside each paragraph its
 * time, as a link like the outline's; with script the paragraph being heard gets the quiet margin
 * mark (`aria-current="time"` on its time; `data-marks` group). Source citations are superscript
 * letters pointing to `#src{idx}` in the list at the foot; the list links back here (`#p{b}-{i}`).
 *
 * Reported speech by construction; no quotation styling anywhere.
 */
import type { PublicRecording, PublicWriteupBlock } from "@emunas/corpus/public";
import Time from "./Time.astro";
import type { Ed } from "../../lib/edition.ts";
import { useShiurT } from "./strings.ts";
import { paragraphAnchor, type SourcesView } from "./view.ts";

interface Props {
  ed: Ed;
  blocks: readonly PublicWriteupBlock[];
  recordings: readonly PublicRecording[];
  sources: SourcesView;
}

const { ed, blocks, recordings, sources } = Astro.props;
const t = useShiurT(ed);
---
<section class="writeup" id="writeup" aria-labelledby="writeup-heading">
  <h2 id="writeup-heading">{t("writeup.heading")}</h2>
  <div class="writeup-text" data-marks>
    {blocks.map((block, b) => (
      <div class="writeup-block">
        {block.heading && <h3>{block.heading}</h3>}
        {block.paragraphs.map((p, i) => {
          const cites = [...new Set(p.src)].map((idx) => sources.byIdx.get(idx)).filter((s) => s !== undefined);
          return (
            <div class="para" id={paragraphAnchor(b, i)} data-mark>
              <span class="para-time">{p.t !== null && <Time ed={ed} recordings={recordings} t={p.t} />}</span>
              <p>
                {p.text}
                {cites.length > 0 && (
                  <sup class="cite">
                    {cites.map((s, k) => (
                      <>{k > 0 && ","}<a href={`#${s.anchor}`} aria-label={t("writeup.cite", { letter: s.letter })}>{s.letter}</a></>
                    ))}
                  </sup>
                )}
              </p>
            </div>
          );
        })}
      </div>
    ))}
  </div>
</section>
