---
/**
 * The apparatus that follows the text (concept-quiet §5.4 part 7), each a short titled list with
 * a time link per item, each omitted entirely when empty: key points, questions and answers (the
 * kushya, then the teretz, set as a pair), stories (title, retelling, the people named), insights,
 * takeaways (headed as things the Mashgiach said, not the site's advice). Nothing renders when all five
 * are empty.
 *
 * A story told in other shiurim too (two or more visible tellings in the corpus layer) gains one
 * line, "told in N other shiurim →", linking to the story's entry (concept-quiet-corpus C4.5),
 * counted in distinct shiurim. The people of a story are the merged story's people from the corpus
 * layer, in the edition's spelling, each marked `data-story-person` for the guard; the extraction's
 * raw names (possible ASR mishearings) are never printed (F.1). No teaching-cluster (עיין) lines in
 * this cut.
 *
 * Every generated text is shown in the edition's language, else the fallback along
 * `CONTENT_FALLBACK`, and carries the `lang`/`dir` of the language shown.
 */
import { corpusLabel, pickText, type LocalizedText } from "@emunas/i18n";
import type { PublicNotes, PublicRecording } from "@emunas/corpus/public";
import Time from "./Time.astro";
import { forwardArrow, nameAttrs } from "../../lib/bidi.ts";
import { langAttrsIn, shownText } from "../../lib/content.ts";
import type { Ed } from "../../lib/edition.ts";
import { useShiurT } from "./strings.ts";
import type { NamedLink, StoryLine } from "./refs.ts";
import { hasApparatus } from "./view.ts";

interface Props {
  ed: Ed;
  notes: PublicNotes;
  recordings: readonly PublicRecording[];
  /** Corpus-layer story lines by story moment id (`refs.ts` `storyLines`). */
  stories?: ReadonlyMap<string, StoryLine>;
}

const { ed, notes, recordings, stories = new Map<string, StoryLine>() } = Astro.props;
const arrow = forwardArrow(ed);
const t = useShiurT(ed);
const moments = [
  { id: "key-points", heading: t("keyPoints.heading"), items: notes.summary.keyPoints },
  { id: "insights", heading: t("insights.heading"), items: notes.insights },
  { id: "takeaways", heading: t("takeaways.heading"), items: notes.takeaways },
] as const;
const [keyPoints, insights, takeaways] = moments;
const attrs = (n: NamedLink) => nameAttrs(n.hebrew, ed);
/** A generated text for the edition (its language, else the fallback), with that language's lang/dir. */
const shown = (text: LocalizedText) => {
  const p = pickText(text, ed);
  return { text: p.text, attrs: langAttrsIn(p, ed) };
};
---
{hasApparatus(notes) && (
  <div class="apparatus" id="apparatus">
    {[keyPoints].filter((m) => m.items.length > 0).map((m) => (
      <section class="apparatus-part" id={m.id} aria-labelledby={`${m.id}-heading`}>
        <h2 id={`${m.id}-heading`}>{m.heading}</h2>
        <ol role="list" class="moment-list">
          {m.items.map((item) => (
            <li>{item.t !== null && <><Time ed={ed} recordings={recordings} t={item.t} />{" "}</>}<span {...shown(item.text).attrs}>{shown(item.text).text}</span></li>
          ))}
        </ol>
      </section>
    ))}
    {notes.questions.length > 0 && (
      <section class="apparatus-part" id="questions" aria-labelledby="questions-heading">
        <h2 id="questions-heading">{t("questions.heading")}</h2>
        <ol role="list" class="qa-list">
          {notes.questions.map((q) => (
            <li class="qa">
              <p class="qa-q">
                <span class="qa-label">{t("questions.q")}:</span>{" "}
                {q.tq !== null && <><Time ed={ed} recordings={recordings} t={q.tq} />{" "}</>}
                <span {...shown(q.q).attrs}>{shown(q.q).text}</span>
              </p>
              <p class="qa-a">
                <span class="qa-label">{t("questions.a")}:</span>{" "}
                {q.ta !== null && <><Time ed={ed} recordings={recordings} t={q.ta} />{" "}</>}
                <span {...shown(q.a).attrs}>{shown(q.a).text}</span>
              </p>
            </li>
          ))}
        </ol>
      </section>
    )}
    {notes.stories.length > 0 && (
      <section class="apparatus-part" id="stories" aria-labelledby="stories-heading">
        <h2 id="stories-heading">{t("stories.heading")}</h2>
        <ol role="list" class="story-list">
          {notes.stories.map((s) => {
            const line = stories.get(s.id);
            const title = shown(s.title);
            const retelling = shownText(s.retelling, ed);
            return (
            <li class="story">
              <h3 class="story-title">
                {s.t !== null && <><Time ed={ed} recordings={recordings} t={s.t} />{" "}</>}
                <span {...title.attrs}>{title.text}</span>
              </h3>
              {retelling && <p {...langAttrsIn(retelling, ed)}>{retelling.text}</p>}
              {line && line.people.length > 0 && (
                <p class="story-people">
                  {t("stories.people")}{" "}
                  {line.people.map((n, i) => (
                    <>{i > 0 && ", "}{n.href ? <a href={n.href}><bdi {...attrs(n)} data-story-person>{n.name}</bdi></a> : <bdi {...attrs(n)} data-story-person>{n.name}</bdi>}</>
                  ))}
                </p>
              )}
              {line && line.otherShiurim > 0 && (
                <p class="story-elsewhere" data-corpus="story">
                  {line.href ? (
                    <a href={line.href}>{corpusLabel("count.toldInOther", ed, { count: line.otherShiurim })} {arrow}</a>
                  ) : (
                    corpusLabel("count.toldInOther", ed, { count: line.otherShiurim })
                  )}
                </p>
              )}
            </li>
            );
          })}
        </ol>
      </section>
    )}
    {[insights, takeaways].filter((m) => m.items.length > 0).map((m) => (
      <section class="apparatus-part" id={m.id} aria-labelledby={`${m.id}-heading`}>
        <h2 id={`${m.id}-heading`}>{m.heading}</h2>
        <ol role="list" class="moment-list">
          {m.items.map((item) => (
            <li>{item.t !== null && <><Time ed={ed} recordings={recordings} t={item.t} />{" "}</>}<span {...shown(item.text).attrs}>{shown(item.text).text}</span></li>
          ))}
        </ol>
      </section>
    ))}
  </div>
)}
