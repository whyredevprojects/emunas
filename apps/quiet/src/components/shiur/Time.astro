---
/**
 * The shiur page's time link: the same link as the shell's `TimeLink.astro` (same `timeTarget`,
 * same no-JS `href="{audioUrl}#t={local}"`, same accessible name "Play from 12:34" / "שפּיל פון
 * 12:34"), in a compact form, because a full shiur page carries 100–150 of them and the long media
 * URLs already cost most of the 120 KB page budget:
 * - the visible time is isolated by `dir="ltr"` on the link itself (an element with `dir` is a bidi
 *   isolate in HTML) instead of an inner `<bdi>`;
 * - only `data-g` (global seconds) is carried; the player finds the recording from it
 *   (`scripts/player.ts` reads `data-rec`/`data-t` when a `TimeLink` provides them).
 * A time whose recording is not playable is plain text, never a dead link.
 */
import { timeTarget, type AudioRecording } from "../../lib/audio.ts";
import { clock } from "../../lib/bidi.ts";
import type { Ed } from "../../lib/edition.ts";
import { useT } from "../../i18n/index.ts";

interface Props {
  ed: Ed;
  recordings: readonly AudioRecording[];
  /** Global seconds. */
  t: number;
}

const { ed, recordings, t: seconds } = Astro.props;
const t = useT(ed);
const target = timeTarget(recordings, seconds);
const global = target?.global ?? Math.max(0, seconds);
const text = clock(global);
const label = target && target.parts > 1 ? t("time.playFromPart", { time: text, part: target.part }) : t("time.playFrom", { time: text });
---
{target?.href ? (
  <a class="time" dir="ltr" href={target.href} data-g={global} aria-label={label}>{text}</a>
) : (
  <span class="time time-unavailable" dir="ltr" data-g={global}>{text}</span>
)}
