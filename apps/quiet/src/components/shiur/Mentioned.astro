---
/**
 * Mentioned in this shiur (concept-quiet §5.4 part 8, concept-quiet-corpus C4.8, C4.2): a compact
 * comma-separated line of people and one of glossary terms, by corpus id with the names from the
 * layer (`refs.ts` `mentionedView`), so "the Sanzer Rav" and "the Divrei Chaim" land on one page.
 * An entry with its own page links there; one listed in its index without a page links to its
 * line there; one in no index is named without a link. No tag cloud.
 */
import type { Ed } from "../../lib/edition.ts";
import type { MentionedView, NamedLink } from "./refs.ts";
import { useShiurT } from "./strings.ts";

interface Props {
  ed: Ed;
  mentioned: MentionedView;
}

const { ed, mentioned } = Astro.props;
const t = useShiurT(ed);
const attrs = (n: NamedLink) => (n.hebrew ? { lang: ed === "yi" ? "yi" : "he", dir: "rtl" } : { lang: "en", dir: "ltr" });
const lines = [
  { label: t("mentioned.people"), items: mentioned.people },
  { label: t("mentioned.concepts"), items: mentioned.concepts },
].filter((l) => l.items.length > 0);
---
{lines.length > 0 && (
  <section class="mentioned" id="mentioned" aria-labelledby="mentioned-heading">
    <h2 id="mentioned-heading">{t("mentioned.heading")}</h2>
    {lines.map((l) => (
      <p class="mentioned-line">
        <span class="label">{l.label}</span>{" "}
        {l.items.map((n, i) => <>{i > 0 && ", "}{n.href ? <a href={n.href}><bdi {...attrs(n)}>{n.name}</bdi></a> : <bdi {...attrs(n)}>{n.name}</bdi>}</>)}
      </p>
    ))}
  </section>
)}
