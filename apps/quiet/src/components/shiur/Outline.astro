---
/**
 * Order of the shiur, סדר השיעור (concept-quiet §5.4 part 4): one entry per chapter with its start
 * time (a link that seeks the player, or opens the recording at that second without script), the
 * title and the 1–3 sentence summary; subsections indented. Anchors `#s{idx}`.
 *
 * `story` chapters get a small "מעשה" mark; singing, another speaker, interludes (`noise`) and
 * brachah are listed in a lighter weight with no summary, with their kind after the title (an
 * interlude's neutral title from the data stands alone). Chapters the catalog title
 * anticipated (`catalogTopicIdx`) are marked "listed in the guide".
 *
 * The list is a margin-mark group (`data-marks`): with script, the chapter being heard gets
 * `aria-current="time"` on its time.
 */
import { sectionKindLabel } from "@emunas/i18n";
import type { PublicChapter, PublicRecording } from "@emunas/corpus/public";
import Time from "./Time.astro";
import type { Ed } from "../../lib/edition.ts";
import { useShiurT } from "./strings.ts";
import { isQuietKind, sectionAnchor } from "./view.ts";

interface Props {
  ed: Ed;
  chapters: readonly PublicChapter[];
  recordings: readonly PublicRecording[];
}

const { ed, chapters, recordings } = Astro.props;
const t = useShiurT(ed);
---
<section class="outline" id="outline" aria-labelledby="outline-heading">
  <h2 id="outline-heading">{t("outline.heading")}</h2>
  <ol role="list" class="outline-list" data-marks>
    {chapters.map((c) => {
      const quiet = isQuietKind(c.kind);
      const title = c.title[ed];
      const summary = c.summary[ed];
      return (
        <li id={sectionAnchor(c.idx)} class:list={["chapter", quiet && "chapter-quiet"]} data-mark>
          <p class="chapter-head">
            <Time ed={ed} recordings={recordings} t={c.t} />
            {" "}
            <span class="chapter-title">{quiet && title === "" ? sectionKindLabel(c.kind, ed) : title}</span>
            {quiet && title !== "" && c.kind !== "noise" && <span class="chapter-kind"> ({sectionKindLabel(c.kind, ed)})</span>}
            {c.kind === "story" && <span class="chapter-mark">{sectionKindLabel("story", ed)}</span>}
            {c.catalogTopicIdx.length > 0 && <span class="chapter-mark">{t("outline.listedInGuide")}</span>}
          </p>
          {!quiet && summary !== "" && <p class="chapter-summary">{summary}</p>}
          {!quiet && c.sub.length > 0 && (
            <ol role="list" class="outline-sub">
              {c.sub.map((s) => (
                <li>
                  <Time ed={ed} recordings={recordings} t={s.t} />
                  {" "}
                  <span class="chapter-title">{s.title[ed]}</span>
                  {s.summary[ed] !== "" && <span class="sub-summary">: {s.summary[ed]}</span>}
                </li>
              ))}
            </ol>
          )}
        </li>
      );
    })}
  </ol>
</section>
