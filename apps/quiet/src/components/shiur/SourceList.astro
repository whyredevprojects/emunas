---
/**
 * Sources, מראי מקומות (concept-quiet §5.4 part 6), grouped by kind of work in traditional order
 * and graded by wording, never colour:
 * - `resolved`: the reference, with a link out to the text (`sefariaRef`);
 * - `inferred`: "apparently" / "לכאורה" before the reference, no link out;
 * - `unresolved` with a work: "Zohar (place not identified)";
 * - `unresolved` with no work: not listed.
 * Each entry has its letter (the superscript in the write-up), its line in the sources index, and
 * the place in the shiur where it comes up: for a source cited in the write-up, the links back to
 * the citing paragraphs (each paragraph's margin time plays from there); for a source the write-up
 * does not cite, its own time link. (Both on every source would put another 60–80 media links on
 * the longest Yiddish pages and push them past the 120 KB budget.)
 * `mention` is not displayed; `heardAs` is not in the public data at all.
 *
 * Markup is kept lean (bare spans styled by position, `dir` on links instead of inner `<bdi>`):
 * a long shiur has 60–80 sources. The small links ("text", "index", the back-link times) take their purpose from the list item
 * they sit in (WCAG 2.4.4, link purpose in context), so they carry no `aria-label`: with 30–80
 * sources per shiur the labels alone would cost 10–15 KB a page against the 120 KB budget.
 */
import type { PublicRecording } from "@emunas/corpus/public";
import Time from "./Time.astro";
import { clock, runAttrs } from "../../lib/bidi.ts";
import type { Ed } from "../../lib/edition.ts";
import { useShiurT } from "./strings.ts";
import type { SourcesView } from "./view.ts";

interface Props {
  ed: Ed;
  sources: SourcesView;
  recordings: readonly PublicRecording[];
}

const { ed, sources, recordings } = Astro.props;
const t = useShiurT(ed);
---
<section class="sources" id="sources" aria-labelledby="sources-heading">
  <h2 id="sources-heading">{t("sources.heading")}</h2>
  {sources.groups.map((g) => (
    <section class="source-group" aria-labelledby={`sources-${g.group}`}>
      <h3 class="label" id={`sources-${g.group}`}>{g.label}</h3>
      <ol role="list" class="source-list">
        {g.sources.map((s) => {
          const ref = <bdi {...runAttrs(s.ref.text, null, ed)}>{s.ref.text}</bdi>;
          return (
            <li id={s.anchor}>
              <span>{s.letter}</span>
              <span>{s.ref.position === "before" && <>{s.ref.qualifier} </>}{ref}{s.ref.position === "after" && <> ({s.ref.qualifier})</>}</span>
              <span class="sx">
                {s.t !== null && s.citedBy.length === 0 && <Time ed={ed} recordings={recordings} t={s.t} />}
                {s.sefaria && <a href={s.sefaria} rel="noopener">{t("sources.sefaria")}</a>}
                {s.indexHref && <a href={s.indexHref}>{t("sources.index")}</a>}
              </span>
              {s.citedBy.length > 0 && (
                <span class="sx">
                  {t("sources.inNotes")}{" "}
                  {s.citedBy.map((c, k) => (
                    <>{k > 0 && ", "}<a href={`#${c.anchor}`} dir="ltr">{c.t !== null ? clock(c.t) : `¶${c.n}`}</a></>
                  ))}
                </span>
              )}
            </li>
          );
        })}
      </ol>
    </section>
  ))}
</section>
