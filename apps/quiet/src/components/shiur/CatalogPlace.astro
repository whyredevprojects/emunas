---
/**
 * Place in the catalog (concept-quiet §5.4 part 9): previous and next in the section and in the
 * series, and "also on פרשת נח" (other shiurim with the same parsha or zman, both languages, with
 * years). Catalog fields only; no AI-made "related shiurim". Rendered on every shiur page, with or
 * without notes.
 */
import { languageName, type AudioLang } from "@emunas/i18n";
import HebrewYear from "../HebrewYear.astro";
import { runAttrs } from "../../lib/bidi.ts";
import type { Ed } from "../../lib/edition.ts";
import { useShiurT } from "./strings.ts";
import type { CatalogPlaceView, PositionView, RowRef } from "./view.ts";

interface Props {
  ed: Ed;
  place: CatalogPlaceView;
  /** Spoken language of the shiur: section names and the parsha/zman are catalog text in it. */
  shiurLang: AudioLang;
}

const { ed, place, shiurLang } = Astro.props;
const t = useShiurT(ed);
const positions: { key: "section" | "series"; view: PositionView; text: string }[] = [];
if (place.section) {
  positions.push({
    key: "section",
    view: place.section,
    text: t("catalog.inSection", { section: "\u0000", pos: place.section.pos, count: place.section.count }),
  });
}
if (place.series) {
  positions.push({
    key: "series",
    view: place.series,
    text: t("catalog.inSeries", { series: "\u0000", pos: place.series.pos, count: place.series.count }),
  });
}
/** Splits "{x}: no. 3 of 13" around the placeholder so the catalog name can be its own run. */
const split = (text: string) => {
  const i = text.indexOf("\u0000");
  return i === -1 ? [text, ""] : [text.slice(0, i), text.slice(i + 1)];
};
const title = (r: RowRef) => r.title || t("catalog.noTitle");
---
<nav class="catalog-place" id="catalog" aria-labelledby="catalog-heading">
  <h2 id="catalog-heading">{t("catalog.heading")}</h2>
  {positions.map(({ key, view, text }) => {
    const [before, after] = split(text);
    const name = view.label || (key === "series" ? t("catalog.seriesFallback") : "");
    const attrs = view.label && view.labelAttrs ? view.labelAttrs : runAttrs(name, shiurLang, ed);
    return (
      <div class="place" data-place={key}>
        <p class="place-where">
          {before}{view.href ? <a href={view.href}><bdi {...attrs}>{name}</bdi></a> : <bdi {...attrs}>{name}</bdi>}{after}
        </p>
        {(view.prev || view.next) && (
          <ul role="list" class="prev-next">
            {view.prev && (
              <li class="prev">
                <span class="label">{t("catalog.prev")}</span>{" "}
                <a href={view.prev.href} rel="prev"><bdi {...runAttrs(title(view.prev), view.prev.lang, ed)}>{title(view.prev)}</bdi></a>
              </li>
            )}
            {view.next && (
              <li class="next">
                <span class="label">{t("catalog.next")}</span>{" "}
                <a href={view.next.href} rel="next"><bdi {...runAttrs(title(view.next), view.next.lang, ed)}>{title(view.next)}</bdi></a>
              </li>
            )}
          </ul>
        )}
      </div>
    );
  })}
  {place.sameOccasion.length > 0 && place.occasion && (
    <div class="place" data-place="occasion">
      <h3 class="place-where">
        {split(t("catalog.sameOccasion", { occasion: "\u0000" }))[0]}<a href={place.occasion.href}><bdi {...runAttrs(place.occasion.raw, shiurLang, ed)}>{place.occasion.raw}</bdi></a>{split(t("catalog.sameOccasion", { occasion: "\u0000" }))[1]}
      </h3>
      <ul role="list" class="same-occasion">
        {place.sameOccasion.map((r) => (
          <li>
            <a href={r.href}><bdi {...runAttrs(title(r), r.lang, ed)}>{title(r)}</bdi></a>
            <span class="row-meta">
              {" · "}{languageName(r.lang, ed)}
              {r.years.length > 0 && <>{" · "}<HebrewYear year={r.years} /></>}
            </span>
          </li>
        ))}
      </ul>
    </div>
  )}
</nav>
