---
/**
 * "This week" on the title page (concept-quiet §5.1): the parsha of the week and the nearest zman,
 * each as a short list of shiur titles with a link into the calendar index. Computed at build time
 * (the site is rebuilt daily), so it needs no script.
 */
import { runAttrs } from "../../lib/bidi.ts";
import type { Ed } from "../../lib/edition.ts";
import type { OccasionPick, ThisWeekModel } from "./model.ts";
import { useCatalogT } from "./strings.ts";

interface Props {
  ed: Ed;
  week: ThisWeekModel;
}

const { ed, week } = Astro.props;
const c = useCatalogT(ed);
const picks = [week.parsha, week.zman].filter((p): p is OccasionPick => p !== null);
const heading = (p: OccasionPick) =>
  p.kind === "parsha"
    ? c("home.parsha", { name: p.label })
    : p.active
      ? c("home.zmanNow", { name: p.label })
      : c("home.zmanSoon", { name: p.label });
---
{picks.length > 0 && (
  <section class="this-week" aria-labelledby="this-week">
    <h2 id="this-week">{c("home.thisWeek")}</h2>
    {week.hebrewDate && (
      <p class="this-week-lead">{c("home.thisWeekLead", { date: week.hebrewDate })}</p>
    )}
    <div class="this-week-grid">
      {picks.map((p) => (
        <section class="occasion" aria-labelledby={`week-${p.kind}`} data-occasion={p.key}>
          <h3 id={`week-${p.kind}`}><a href={p.href}>{heading(p)}</a></h3>
          <ul role="list">
            {p.rows.map((r) => (
              <li><a href={r.href}><bdi {...runAttrs(r.title, r.lang)}>{r.title}</bdi></a></li>
            ))}
          </ul>
          <p class="occasion-all"><a href={p.href}>{c("home.allOn", { count: p.count, name: p.label })}</a></p>
        </section>
      ))}
    </div>
  </section>
)}

<style>
  .this-week > * + * {
    margin-block-start: var(--space-s);
  }

  .this-week-lead {
    font-size: var(--step-0);
    color: var(--color-ink-muted);
  }

  .this-week-grid {
    display: grid;
    gap: var(--space-l);
  }

  @media (min-width: 40rem) {
    .this-week-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .occasion > * + * {
    margin-block-start: var(--space-xs);
  }

  .occasion li + li {
    margin-block-start: var(--space-2xs);
  }

  .occasion ul {
    font-size: var(--step-0);
  }

  .occasion-all {
    font-size: var(--step-0);
  }
</style>
