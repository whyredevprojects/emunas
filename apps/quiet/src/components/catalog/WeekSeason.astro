---
/**
 * One long window (a month, Sefirah, the Three Weeks) in the season line of "this week" on the title
 * page: a link into the calendar index and when it is ("Now", or "From 1 Elul" for one not yet
 * begun). The text depends only on the window and its state, so it is safe in the day templates.
 */
import type { Ed } from "../../lib/edition.ts";
import type { SeasonPick } from "./model.ts";
import { useCatalogT } from "./strings.ts";

interface Props {
  ed: Ed;
  pick: SeasonPick;
}

const { ed, pick: p } = Astro.props;
const c = useCatalogT(ed);
const when = p.active ? c("home.seasonNow") : p.startDay ? c("home.zmanFrom", { ...p.startDay }) : null;
---
<li data-season={p.key}><a href={p.href}>{p.label}</a>{when && <span class="season-when">{when}</span>}</li>

<style>
  .season-when {
    margin-inline-start: var(--space-2xs);
  }

  .season-when::before {
    content: "(";
  }

  .season-when::after {
    content: ")";
  }
</style>
