---
/**
 * One occasion block of "this week" on the title page (concept-quiet §5.1). It has a heading that
 * links into the calendar index; for a zman that has not begun yet, the day it begins ("On 11 Adar
 * II", "From 25 Kislev"); a few shiur titles; and a link to all of them. Rendered in the visible
 * grid and inside the per-day templates of ThisWeek.astro; from the third zman of a day on, the
 * grid shows it compact (heading, day and link only).
 */
import { runAttrs } from "../../lib/bidi.ts";
import type { Ed } from "../../lib/edition.ts";
import type { OccasionPick } from "./model.ts";
import { useCatalogT } from "./strings.ts";

interface Props {
  ed: Ed;
  pick: OccasionPick;
}

const { ed, pick: p } = Astro.props;
const c = useCatalogT(ed);
const heading =
  p.kind === "parsha"
    ? c("home.parsha", { name: p.label })
    : p.when === "now"
      ? c("home.zmanNow", { name: p.label })
      : p.when === "next"
        ? c("home.zmanNext", { name: p.label })
        : c("home.zmanSoon", { name: p.label });
const day = p.kind === "zman" && !p.active && p.startDay ? c(p.oneDay ? "home.zmanOn" : "home.zmanFrom", { ...p.startDay }) : null;
const id = `week-${p.kind}-${p.key}`;
---
<section class="occasion" aria-labelledby={id} data-occasion={p.key} data-kind={p.kind} data-when={p.when}>
  <h3 id={id}><a href={p.href}>{heading}</a></h3>
  {day && <p class="occasion-day">{day}</p>}
  <ul role="list">
    {p.rows.map((r) => (
      <li><a href={r.href}><bdi {...runAttrs(r.title, r.lang, ed)}>{r.title}</bdi></a></li>
    ))}
  </ul>
  <p class="occasion-all"><a href={p.href}>{c("home.allOn", { count: p.count, name: p.label })}</a></p>
</section>

<style>
  .occasion > * + * {
    margin-block-start: var(--space-xs);
  }

  .occasion li + li {
    margin-block-start: var(--space-2xs);
  }

  .occasion ul {
    font-size: var(--step-0);
  }

  .occasion-all {
    font-size: var(--step-0);
  }

  .occasion-day {
    font-size: var(--step-0);
    color: var(--color-ink-muted);
  }
</style>
