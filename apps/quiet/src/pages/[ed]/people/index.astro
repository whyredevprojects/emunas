---
/**
 * שמות, the index of names (Quiet C4.3; corpus-wave-plan C2.1): the merged people of the corpus
 * layer in blocks by era (`namesIndex` in components/names/model.ts), alphabetical inside each,
 * with "also:" names on the line and "ראה" lines in the alphabet. A person with a page links to it;
 * anyone else's line carries their shiurim. Every person line has its id as anchor, which is where
 * @emunas/links sends a person without a page.
 */
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import CiteList from "../../../components/indexes/CiteList.astro";
import EntryIndexHead from "../../../components/indexes/EntryIndexHead.astro";
import JumpList from "../../../components/indexes/JumpList.astro";
import { entryData } from "../../../components/indexes/entries.ts";
import { entryCrumbs, entryIndexTitle } from "../../../components/indexes/crumbs.ts";
import { useIndexesT } from "../../../components/indexes/strings.ts";
import { namesIndex } from "../../../components/names/model.ts";
import { EDS, type Ed } from "../../../lib/edition.ts";

export const getStaticPaths = (() => (entryData() ? EDS.map((ed) => ({ params: { ed } })) : [])) satisfies GetStaticPaths;

const ed = Astro.params.ed as Ed;
const data = entryData()!;
const t = useIndexesT(ed);
const title = entryIndexTitle(ed, "people");
const groups = namesIndex(data, ed);
---
<Base ed={ed} title={title} crumbs={entryCrumbs(ed, "people")}>
  <EntryIndexHead ed={ed} title={title} intro={t("names.intro")} visibleShiurim={data.layer.visibleShiurim} />
  <JumpList ed={ed} items={groups.map((g) => ({ id: g.id, label: g.label }))} />
  {groups.map((g) => (
    <section class="index-block" id={g.id} aria-labelledby={`${g.id}-h`} data-group={g.group}>
      <h2 id={`${g.id}-h`}>{g.label}</h2>
      <ul class="entries" role="list">
        {g.lines.map((l) =>
          l.kind === "see" ? (
            <li class="see-line" data-see={l.id}>
              <bdi lang={l.name.lang} dir={l.name.dir}>{l.name.text}</bdi>{", "}<span class="see-label">{t("names.see")}</span>{" "}<a href={l.href}><bdi lang={l.target.lang} dir={l.target.dir}>{l.target.text}</bdi></a>
            </li>
          ) : (
            <li id={l.id} data-person={l.id}>
              {l.href ? (
                <a class="entry-name" href={l.href}><bdi lang={l.name.lang} dir={l.name.dir}>{l.name.text}</bdi></a>
              ) : (
                <span class="entry-name"><bdi lang={l.name.lang} dir={l.name.dir}>{l.name.text}</bdi></span>
              )}
              {l.alt && <> <span class="alt-name"><bdi lang={l.alt.lang} dir={l.alt.dir}>{l.alt.text}</bdi></span></>}
              <span class="entry-count">{l.countText}</span>
              <CiteList ed={ed} cites={l.cites} />
              {l.also.length > 0 && (
                <p class="entry-also">{t("names.also")}{" "}{l.also.map((n, i) => <>{i > 0 && ", "}<bdi lang={n.lang} dir={n.dir}>{n.text}</bdi></>)}</p>
              )}
            </li>
          ),
        )}
      </ul>
    </section>
  ))}
</Base>
