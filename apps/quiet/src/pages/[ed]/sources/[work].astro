---
/**
 * A work's page (concept-quiet §5.7; tech-quiet §2 `/{ed}/sources/{workKey}/`): its references in
 * the work's own order (perek and pasuk, or daf), each followed by the shiurim that bring it, each
 * linking to the moment. "apparently" marks an inferred place; a Sefaria link only where a mention
 * resolved the place. References that could not be ordered, then mentions with no place, come last.
 * Built only for works with a page by the threshold rule (`entities.json` quietPage).
 */
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import IndexHead from "../../../components/indexes/IndexHead.astro";
import MentionList from "../../../components/indexes/MentionList.astro";
import { indexesData } from "../../../components/indexes/corpus.ts";
import { indexCrumbs } from "../../../components/indexes/crumbs.ts";
import { pageKeys, workPage } from "../../../components/indexes/model.ts";
import { useIndexesT } from "../../../components/indexes/strings.ts";
import { EDS, type Ed } from "../../../lib/edition.ts";

export const getStaticPaths = (() => {
  const data = indexesData();
  if (!data) return [];
  const keys = pageKeys(data, "work");
  const works = data.works.works.filter((w) => keys.has(w.key));
  return EDS.flatMap((ed) => works.map((w) => ({ params: { ed, work: w.key } })));
}) satisfies GetStaticPaths;

const ed = Astro.params.ed as Ed;
const data = indexesData()!;
const work = data.works.works.find((w) => w.key === Astro.params.work)!;
const t = useIndexesT(ed);
const page = workPage(data, ed, work);
const meta = `${page.groupLabel} · ${t("count.shiurim", { count: page.shiurCount })} · ${t("count.mentions", { count: page.mentionCount })}`;
---
<Base ed={ed} title={page.name.text} crumbs={indexCrumbs(ed, "sources", page.name)}>
  <IndexHead ed={ed} title={page.name} alt={page.alt} meta={meta} counts={data.build.counts} />
  {page.names.length > 0 && (
    <p class="entity-names">{t("names.label")}{" "}{page.names.map((n, i) => <>{i > 0 && ", "}<bdi lang={n.lang} dir={n.dir}>{n.text}</bdi></>)}</p>
  )}
  {page.refs.length > 0 && (
    <section class="index-block" aria-labelledby="refs-h">
      <h2 id="refs-h" class="label">{t("work.refs")}</h2>
      <ul class="entries" role="list">
        {page.refs.map((r) => (
          <li>
            <span class="ref-label"><bdi lang={r.label.lang} dir={r.label.dir}>{r.label.text}</bdi></span>
            {r.sefaria && <> <a class="external" href={r.sefaria} rel="noopener external" aria-label={t("work.onSefariaLabel", { ref: r.label.text })}>{t("work.onSefaria")}</a></>}
            {" "}<MentionList ed={ed} mentions={r.mentions} />
          </li>
        ))}
      </ul>
    </section>
  )}
  {page.otherRefs.length > 0 && (
    <section class="index-block" aria-labelledby="other-h">
      <h2 id="other-h" class="label">{t("work.otherRefs")}</h2>
      <MentionList ed={ed} mentions={page.otherRefs} />
    </section>
  )}
  {page.unplaced.length > 0 && (
    <section class="index-block" aria-labelledby="unplaced-h">
      <h2 id="unplaced-h" class="label">{t("work.placeNotIdentified")}</h2>
      <MentionList ed={ed} mentions={page.unplaced} />
    </section>
  )}
</Base>
