---
/**
 * מראי מקומות, the works index (Quiet C4.4; corpus-wave-plan C2.1): the merged works of the corpus
 * layer in mafteach order (`worksIndex` in components/indexes/works.ts), each family's child works
 * under it, generic labels last. A work with a page links to it; any other work's line carries its
 * shiurim. Every line has the work id as anchor (where @emunas/links sends a work without a page).
 */
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import CiteList from "../../../components/indexes/CiteList.astro";
import EntryIndexHead from "../../../components/indexes/EntryIndexHead.astro";
import JumpList from "../../../components/indexes/JumpList.astro";
import { entryData } from "../../../components/indexes/entries.ts";
import { entryCrumbs, entryIndexTitle } from "../../../components/indexes/crumbs.ts";
import { useIndexesT } from "../../../components/indexes/strings.ts";
import { worksIndex } from "../../../components/indexes/works.ts";
import { EDS, type Ed } from "../../../lib/edition.ts";

export const getStaticPaths = (() => EDS.map((ed) => ({ params: { ed } }))) satisfies GetStaticPaths;

const ed = Astro.params.ed as Ed;
const data = entryData();
const t = useIndexesT(ed);
const title = entryIndexTitle(ed, "sources");
const blocks = worksIndex(data, ed);
---
<Base ed={ed} title={title} crumbs={entryCrumbs(ed, "sources")}>
  <EntryIndexHead ed={ed} title={title} intro={t("works.intro")} visibleShiurim={data.layer.visibleShiurim} />
  <JumpList ed={ed} items={blocks.map((b) => ({ id: b.id, label: b.label }))} />
  {blocks.map((b) => (
    <section class="index-block" id={b.id} aria-labelledby={`${b.id}-h`} data-group={b.group}>
      <h2 id={`${b.id}-h`}>{b.label}</h2>
      {b.note && <p class="index-block-note">{b.note}</p>}
      <ul class="entries" role="list">
        {b.works.map((w) => (
          <li id={w.id} data-work={w.id} data-depth={w.depth > 0 ? String(Math.min(w.depth, 3)) : undefined}>
            {w.href ? (
              <a class="entry-name" href={w.href}><bdi lang={w.name.lang} dir={w.name.dir}>{w.name.text}</bdi></a>
            ) : (
              <span class="entry-name"><bdi lang={w.name.lang} dir={w.name.dir}>{w.name.text}</bdi></span>
            )}
            {w.alt && <> <span class="alt-name"><bdi lang={w.alt.lang} dir={w.alt.dir}>{w.alt.text}</bdi></span></>}
            <span class="entry-count">{w.countText}</span>
            <CiteList ed={ed} cites={w.cites} />
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
