---
/**
 * Contents (concept-quiet §5.2, tech-quiet §2 `/{ed}/contents/`): the sections in catalog order,
 * the Yiddish sections and the English sections each under their own heading, then the sections of
 * the other recordings ("More recordings"), then the series. Each line: the section title and its
 * count.
 */
import Base from "../../../layouts/Base.astro";
import { loadCatalogCorpus } from "../../../components/catalog/corpus.ts";
import { contentsModel, sectionHref, type SectionSummary, type SeriesSummary } from "../../../components/catalog/model.ts";
import { useCatalogT } from "../../../components/catalog/strings.ts";
import { runAttrs } from "../../../lib/bidi.ts";
import { EDS, type Ed } from "../../../lib/edition.ts";

export function getStaticPaths() {
  return EDS.map((ed) => ({ params: { ed } }));
}

const ed = Astro.params.ed as Ed;
const corpus = loadCatalogCorpus();
const model = contentsModel(corpus, ed);
const c = useCatalogT(ed);
const groups: { id: string; title: string; sections: SectionSummary[] }[] = [
  { id: "yiddish", title: c("contents.yiddish"), sections: model.yiddish },
  { id: "english", title: c("contents.english"), sections: model.english },
  { id: "more", title: c("contents.more"), sections: model.more },
].filter((g) => g.sections.length > 0);
const series: { id: string; title: string; list: SeriesSummary[] }[] = [
  { id: "series-yi", title: c("contents.yiddish"), list: model.series.yi },
  { id: "series-en", title: c("contents.english"), list: model.series.en },
].filter((g) => g.list.length > 0);
---
<Base ed={ed} title={c("contents.title")}>
  <h1>{c("contents.title")}</h1>

  {groups.map((g) => (
    <section class="contents-group" aria-labelledby={g.id}>
      <h2 id={g.id}>{g.title}</h2>
      <ol role="list" class="toc" data-group={g.id}>
        {g.sections.map((s) => (
          <li data-section={s.key}>
            <a href={sectionHref(ed, s)}><bdi {...runAttrs(s.title, s.lang, ed)}>{s.title}</bdi></a>
            <span class="toc-leader" aria-hidden="true"></span>
            <span class="toc-count">{c("count.shiurim", { count: s.count })}</span>
          </li>
        ))}
      </ol>
    </section>
  ))}

  <section class="contents-group" aria-labelledby="series">
    <h2 id="series">{c("contents.series")}</h2>
    <p class="lead">{c("contents.seriesLead")}</p>
    {series.map((g) => (
      <>
        <h3 id={g.id}>{g.title}</h3>
        <ul role="list" class="toc">
          {g.list.map((s) => (
            <li data-series={s.id}>
              <a href={s.href}><bdi lang={s.titleLang} dir={s.titleDir}>{s.title}</bdi></a>
              <span class="toc-leader" aria-hidden="true"></span>
              <span class="toc-count">{c("count.shiurim", { count: s.count })}</span>
            </li>
          ))}
        </ul>
      </>
    ))}
  </section>
</Base>

<style>
  .lead {
    color: var(--color-ink-muted);
    font-size: var(--step-0);
  }

  .contents-group > * + * {
    margin-block-start: var(--space-s);
  }

  .toc li {
    display: flex;
    align-items: baseline;
    column-gap: var(--space-xs);
    padding-block: var(--space-2xs);
    border-block-end: var(--rule-hairline) solid var(--color-rule);
  }

  .toc-leader {
    flex: 1 1 auto;
  }

  .toc-count {
    flex: 0 0 auto;
    font-size: var(--step-0);
    color: var(--color-ink-muted);
    white-space: nowrap;
  }
</style>
