---
/**
 * A topic's entry in מפתח הענינים (concept-quiet-corpus C4.1 "A topic page"; corpus-wave-plan
 * C2.2; `/{ed}/inyanim/{topicId}/`). Parts 1–4 and 6: headword, place in the tree and "see also";
 * the description as notes; the glossary definition when a concept shares the subject; "begin
 * here"; the shiurim in three grades. A gateway (level 1, or above the policy's gateway count) shows
 * its children with their descriptions and "begin here", and sends the reader to the complete list
 * on `all/`. The AI label and the report link at the foot, once.
 */
import type { GetStaticPaths } from "astro";
import Base from "../../../../layouts/Base.astro";
import EntityLabel from "../../../../components/corpus/EntityLabel.astro";
import ReportEntry from "../../../../components/corpus/ReportEntry.astro";
import ShiurList from "../../../../components/calendar/ShiurList.astro";
import { occasionLookup, shiurEntry } from "../../../../components/calendar/model.ts";
import TopicGrades from "../../../../components/topics/TopicGrades.astro";
import TopicHead from "../../../../components/topics/TopicHead.astro";
import TopicName from "../../../../components/topics/TopicName.astro";
import { topicCrumbs } from "../../../../components/topics/crumbs.ts";
import { topicsSource } from "../../../../components/topics/data.ts";
import { topicGrades, topicHref, topicPage, topicPageIds } from "../../../../components/topics/model.ts";
import { useTopicsT } from "../../../../components/topics/strings.ts";
import { langAttrs } from "../../../../lib/content.ts";
import { EDS, type Ed } from "../../../../lib/edition.ts";
import "../../../../components/topics/topics.css";

export const getStaticPaths = (() => {
  const src = topicsSource();
  const { pages } = topicPageIds(src);
  return EDS.flatMap((ed) => pages.map((topic) => ({ params: { ed, topic } })));
}) satisfies GetStaticPaths;

const ed = Astro.params.ed as Ed;
const id = Astro.params.topic as string;
const src = topicsSource();
const page = topicPage(ed, src, id);
if (!page) throw new Error(`inyanim: unknown topic ${id}`);
const t = useTopicsT(ed);
const lookup = src.occasions ? occasionLookup(src.occasions) : undefined;
const hubs = page.hubs.map((h) => shiurEntry(src.rows.get(h)!, ed, lookup ? { lookup } : {}));
const grades = page.gateway ? null : topicGrades(ed, src, src.topicDetail(id));
---
<Base ed={ed} title={page.name.title.text} crumbs={topicCrumbs(ed, page)} {...(page.description ? { description: page.description.text } : {})}>
  <TopicHead ed={ed} page={page} />

  {page.gateway && page.children.length > 0 && (
    <section class="topic-section" aria-labelledby="children-h">
      <h2 id="children-h">{t("topic.children")}</h2>
      <ul role="list" class="topic-children">
        {page.children.map((c) => (
          <li data-topic={c.id}>
            {c.href ? <a href={c.href}><TopicName name={c.name} /></a> : <TopicName name={c.name} />}{" "}
            <span class="count">{t("count.shiurim", { count: c.count })}</span>
            {c.description && <p {...langAttrs(c.description)}>{c.description.text}</p>}
          </li>
        ))}
      </ul>
    </section>
  )}

  {hubs.length > 0 && (
    <section class="topic-section topic-hubs" aria-labelledby="hubs-h">
      <h2 id="hubs-h">{t("topic.beginHere")}</h2>
      <ShiurList ed={ed} entries={hubs} />
    </section>
  )}

  {page.gateway ? (
    <p class="topic-section full-list"><a href={topicHref(ed, id, true)}>{t("topic.fullList", { count: page.count })}</a></p>
  ) : (
    grades && <TopicGrades ed={ed} grades={grades} />
  )}

  <EntityLabel ed={ed} variant="entry" reviewed={page.reviewed}>
    <ReportEntry ed={ed} kind="topic" id={id} />
  </EntityLabel>
</Base>
