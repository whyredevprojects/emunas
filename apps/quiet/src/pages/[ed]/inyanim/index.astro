---
/**
 * מפתח הענינים, the topic index (concept-quiet-corpus C4.1 "The tree page"; corpus-wave-plan
 * §3.5 `/{ed}/inyanim/`): the whole taxonomy on one page, as the subject index of a sefer. Gates as
 * headings, their topics beneath, deeper topics run in after a dash; the Hebrew term with its count.
 * The AI label once, under the heading. Built only when the corpus layer is there.
 */
import type { GetStaticPaths } from "astro";
import { corpusLabel } from "@emunas/i18n";
import Base from "../../../layouts/Base.astro";
import EntityLabel from "../../../components/corpus/EntityLabel.astro";
import CalendarRule from "../../../components/topics/CalendarRule.astro";
import TopicTree from "../../../components/topics/TopicTree.astro";
import { topicsLayer, topicsSource } from "../../../components/topics/data.ts";
import { topicTree } from "../../../components/topics/model.ts";
import { useTopicsT } from "../../../components/topics/strings.ts";
import { EDS, type Ed } from "../../../lib/edition.ts";
import { INDEXES_ANCHOR } from "../../../lib/nav.ts";
import { useT } from "../../../i18n/index.ts";
import { formatQuiet } from "@emunas/links";

export const getStaticPaths = (() => (topicsSource() ? EDS.map((ed) => ({ params: { ed } })) : [])) satisfies GetStaticPaths;

const ed = Astro.params.ed as Ed;
const src = topicsSource()!;
const layer = topicsLayer();
const t = useTopicsT(ed);
const ui = useT(ed);
const title = corpusLabel("index.topics", ed);
const gates = topicTree(ed, src);
---
<Base
  ed={ed}
  title={title}
  crumbs={[{ label: ui("nav.indexes"), href: `${formatQuiet({ kind: "home", ed })}#${INDEXES_ANCHOR}` }, { label: title }]}
>
  <header class="index-head topic-index-head">
    <h1>{title}</h1>
    <EntityLabel ed={ed} variant="index" count={layer.visibleShiurim} />
    <p class="index-intro">{t("tree.intro")}</p>
    <CalendarRule ed={ed} />
  </header>
  <TopicTree ed={ed} gates={gates} />
</Base>
