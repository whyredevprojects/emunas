---
/**
 * `/{ed}/about/` (concept-quiet §5.11, tech-quiet §2): the Mashgiach and the collection, how the site is
 * arranged, how the notes were made (`#notes`, the anchor every notes label links to), how to
 * report an error (`#report`), what is not included (`#excluded`).
 *
 * Every text on this page is written by a person (W5.3) and read from
 * `src/content/about/{ed}/{part}.md`; a part whose file does not exist yet is left out (its draft
 * waits in `src/content/about-drafts/`). The only non-heading content is the report address from `EMUNAS_FEEDBACK_EMAIL`
 * (a dev placeholder outside deploy builds, ../../../components/seo/site-env.ts). The texts' links
 * to the listening app and the Pocket Guide are resolved here (`resolveAboutLinks`).
 */
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import { currentSiteEnv } from "../../../components/seo/site-env.ts";
import { pocketGuideUrl } from "../../../components/catalog/model.ts";
import { useT } from "../../../i18n/index.ts";
import { EDS, type Ed } from "../../../lib/edition.ts";
import { loadCatalogCorpus } from "../../../components/catalog/corpus.ts";
import { aboutText, resolveAboutLinks } from "./_content.ts";
import { ABOUT_PARTS, ABOUT_STRINGS } from "./_strings.ts";
import "./_about.css";

export const getStaticPaths = (() => EDS.map((ed) => ({ params: { ed } }))) satisfies GetStaticPaths;

const ed = Astro.params.ed as Ed;
const s = ABOUT_STRINGS[ed];
const env = currentSiteEnv();
const targets = { ed, live: env.links.live.home(ed), guide: pocketGuideUrl(loadCatalogCorpus()), newTab: useT(ed)("link.newTab") };
const parts = await Promise.all(
  ABOUT_PARTS.flatMap((part) => {
    const text = aboutText(ed, part);
    return text ? [text.compiledContent().then((html) => ({ part, html: resolveAboutLinks(html, targets) }))] : [];
  }),
);
---
<Base ed={ed} title={s.title}>
  <article class="about">
    <h1>{s.title}</h1>
    {parts.map(({ part, html }) => {
      return (
        <section id={part} aria-labelledby={`${part}-heading`}>
          <h2 id={`${part}-heading`}>{s.headings[part]}</h2>
          <div class="about-text" set:html={html} />
          {part === "report" && (
            <p class="about-report">
              {s.reportAddress}{" "}
              <a href={`mailto:${env.feedbackEmail}`}><bdi dir="ltr">{env.feedbackEmail}</bdi></a>
              {env.placeholder.feedbackEmail && <> {s.reportPlaceholderAddress}</>}
            </p>
          )}
        </section>
      );
    })}
  </article>
</Base>
