---
/**
 * `/{ed}/shiur/{shiurId}/`: one page per in-scope shiur per edition (tech-quiet §2), built from
 * `.corpus/shiurim/<id>.json` and the aggregate files (integration-plan §5.1). The page body is
 * `components/shiur/ShiurPage.astro`; this file only resolves the data.
 *
 * Build config read here (all optional):
 * - `EMUNAS_CORPUS_DIR`: where `.corpus/` is (default: found walking up from the working dir);
 * - host variables of `@emunas/links` (`EMUNAS_DOMAIN`, …): for "Open in the listening app";
 *   without them the link is left out;
 * - `EMUNAS_FEEDBACK_EMAIL`: the "report an error" address; without it the line is left out.
 */
import type { GetStaticPaths } from "astro";
import { createLinks, hostsFromEnv, type Links } from "@emunas/links";
import ShiurPage from "../../../../components/shiur/ShiurPage.astro";
import { currentCorpus } from "../../../../components/shiur/corpus.ts";
import { useShiurT } from "../../../../components/shiur/strings.ts";
import { catalogPlace, reportHref } from "../../../../components/shiur/view.ts";
import { EDS, type Ed } from "../../../../lib/edition.ts";

export const getStaticPaths = (() => {
  const corpus = currentCorpus();
  if (!corpus) return [];
  return EDS.flatMap((ed) => corpus.index.shiurim.map((row) => ({ params: { ed, id: row.id } })));
}) satisfies GetStaticPaths;

const ed = Astro.params.ed as Ed;
const id = Astro.params.id as string;
const corpus = currentCorpus();
if (!corpus) throw new Error("shiur page without a corpus");
const shiur = corpus.shiur(id);
const place = catalogPlace(ed, shiur, corpus.neighbours[id], corpus.rows, (sid) => corpus.seriesTitle(sid, ed));

let links: Links | null = null;
try {
  links = createLinks({ hosts: hostsFromEnv(process.env) });
} catch {
  links = null; // hosts not configured (local builds): no cross-site link
}
const t = useShiurT(ed);
const pageUrl = links ? links.quiet.shiur(ed, id) : `/${ed}/shiur/${id}/`;
const report = reportHref(
  process.env["EMUNAS_FEEDBACK_EMAIL"],
  t("report.subject", { id }),
  t("report.body", { id, url: pageUrl }),
);
---
<ShiurPage
  ed={ed}
  shiur={shiur}
  place={place}
  counts={corpus.entityCounts}
  personName={corpus.personName}
  liveHref={links ? links.live.shiur(ed, id) : null}
  reportHref={report}
/>
