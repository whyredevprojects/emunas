---
/**
 * One parsha (concept-quiet §5.5): every shiur on it, Yiddish and English together, by year, with
 * section, language and one-liner. Where the occasion is linked to a topic, one line sends the
 * reader to the topic index for the shiurim on it said at other times (concept-quiet-corpus C4.1).
 * One page per parsha key in `.corpus/occasions.json`.
 */
import type { GetStaticPaths } from "astro";
import Base from "../../../../../layouts/Base.astro";
import CalendarViews from "../../../../../components/calendar/CalendarViews.astro";
import NotesKey from "../../../../../components/calendar/NotesKey.astro";
import OccasionName from "../../../../../components/calendar/OccasionName.astro";
import ShiurList from "../../../../../components/calendar/ShiurList.astro";
import TopicLine from "../../../../../components/calendar/TopicLine.astro";
import { loadCalendarData } from "../../../../../components/calendar/data.ts";
import { calendarHref, occasionPage, parshaKeys } from "../../../../../components/calendar/model.ts";
import { useCalendarT } from "../../../../../components/calendar/strings.ts";
import { formatQuiet } from "@emunas/links";
import { occasionNameAttrs } from "../../../../../lib/content.ts";
import { EDS, type Ed } from "../../../../../lib/edition.ts";

export const getStaticPaths = (() => {
  const data = loadCalendarData();
  if (!data) return [];
  return EDS.flatMap((ed) => parshaKeys(data.occasions).map((key) => ({ params: { ed, key } })));
}) satisfies GetStaticPaths;

const ed = Astro.params.ed as Ed;
const key = Astro.params.key as string;
const data = loadCalendarData();
if (!data) throw new Error("calendar: no .corpus/");
const page = occasionPage(data, "parsha", key, ed);
if (!page) throw new Error(`calendar: unknown parsha ${key}`);
const t = useCalendarT(ed);
// `he` is null in a Hebrew-script edition (the name is already Hebrew).
const title = `${page.name} ${page.he ?? ""}`.trim();
---
<Base
  ed={ed}
  title={title}
  crumbs={[
    { label: t("cal.label"), href: calendarHref(ed) },
    { label: t("cal.byParsha"), href: formatQuiet({ kind: "index", ed, index: "calendar-parsha" }) },
    { label: page.name, ...occasionNameAttrs(ed) },
  ]}
>
  <h1><OccasionName ed={ed} name={page} /></h1>
  <CalendarViews ed={ed} current="parsha" />
  <TopicLine ed={ed} kind="parsha" occasionKey={key} name={page.name} />
  {page.count > 0 ? (
    <>
      <p class="cal-intro">{t("cal.parsha.pageIntro")} <span class="count">{t("cal.count", { count: page.count })}</span></p>
      <NotesKey ed={ed} entries={page.shiurim} />
      <ShiurList ed={ed} entries={page.shiurim} />
    </>
  ) : (
    <p class="cal-intro cal-empty">{t("cal.parsha.empty")}</p>
  )}
</Base>
