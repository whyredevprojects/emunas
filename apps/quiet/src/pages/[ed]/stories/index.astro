---
/**
 * מעשיות, the stories index (Quiet C4.5), on the corpus layer's merged stories. Three parts:
 * most retold (four or more tellings, the most often told first), by person in the groups of the
 * index of names, and without a name (alphabetical). A story told in more than one shiur links to
 * its own page; a story told once links to the place in the shiur. The AI label sits under the
 * heading, once (Quiet C6). Built only when the layer is there; otherwise the title page leaves
 * the line out.
 */
import type { GetStaticPaths } from "astro";
import { corpusLabel } from "@emunas/i18n";
import Base from "../../../layouts/Base.astro";
import JumpList from "../../../components/catalog/JumpList.astro";
import { loadCatalogCorpus } from "../../../components/catalog/corpus.ts";
import { indexRows } from "../../../components/catalog/model.ts";
import EntityLabel from "../../../components/corpus/EntityLabel.astro";
import { quietLayer } from "../../../components/corpus/layer.ts";
import StoryLine from "../../../components/stories/StoryLine.astro";
import { MOST_RETOLD_MIN, STORIES_ANCHORS, storiesCrumbs, storiesIndexModel } from "../../../components/stories/model.ts";
import { useStoriesT } from "../../../components/stories/strings.ts";
import "../../../components/stories/stories.css";
import { EDS, type Ed } from "../../../lib/edition.ts";

export const getStaticPaths = (() => (quietLayer().enabled ? EDS.map((ed) => ({ params: { ed } })) : [])) satisfies GetStaticPaths;

const ed = Astro.params.ed as Ed;
const layer = quietLayer();
const t = useStoriesT(ed);
const title = corpusLabel("index.stories", ed);
const model = storiesIndexModel(ed, layer, indexRows(loadCatalogCorpus()));
const jump = [
  ...(model.mostRetold.length > 0 ? [{ id: STORIES_ANCHORS.mostRetold, label: t("index.mostRetold"), count: model.mostRetold.length }] : []),
  ...(model.groups.length > 0
    ? [
        {
          id: STORIES_ANCHORS.byPerson,
          label: t("index.byPerson"),
          children: model.groups.map((g) => ({ id: g.anchor, label: g.label })),
        },
      ]
    : []),
  ...(model.withoutName.length > 0 ? [{ id: STORIES_ANCHORS.withoutName, label: t("index.withoutName"), count: model.withoutName.length }] : []),
];
---
<Base ed={ed} title={title} crumbs={storiesCrumbs(ed)}>
  <header class="index-head">
    <h1>{title}</h1>
    <p class="stories-lead">{t("index.lead")}</p>
    <EntityLabel ed={ed} variant="index" count={layer.visibleShiurim} />
  </header>

  {jump.length > 1 && <JumpList ed={ed} label={t("index.jump")} items={jump} />}

  {model.mostRetold.length > 0 && (
    <section class="stories-part" id={STORIES_ANCHORS.mostRetold} aria-labelledby={`${STORIES_ANCHORS.mostRetold}-h`}>
      <h2 id={`${STORIES_ANCHORS.mostRetold}-h`}>{t("index.mostRetold")}</h2>
      <p class="stories-lead">{t("index.mostRetoldLead", { min: MOST_RETOLD_MIN })}</p>
      <ul class="story-lines" role="list">
        {model.mostRetold.map((line) => <StoryLine ed={ed} line={line} />)}
      </ul>
    </section>
  )}

  {model.groups.length > 0 && (
    <section class="stories-part" id={STORIES_ANCHORS.byPerson} aria-labelledby={`${STORIES_ANCHORS.byPerson}-h`}>
      <h2 id={`${STORIES_ANCHORS.byPerson}-h`}>{t("index.byPerson")}</h2>
      <p class="stories-lead">{t("index.byPersonLead")}</p>
      {model.groups.map((g) => (
        <section class="stories-group" id={g.anchor} aria-labelledby={`${g.anchor}-h`}>
          <h3 id={`${g.anchor}-h`}>{g.label}</h3>
          {g.people.map((p) => (
            <section class="stories-person" id={p.anchor} aria-labelledby={`${p.anchor}-h`}>
              <h4 id={`${p.anchor}-h`}>
                <a href={p.href}><bdi lang={p.name.lang} dir={p.name.dir} data-story-person>{p.name.text}</bdi></a>
                {p.alt && <> <span class="alt-name"><bdi lang={p.alt.lang} dir={p.alt.dir} data-story-person>{p.alt.text}</bdi></span></>}
              </h4>
              <ul class="story-lines" role="list">
                {p.stories.map((line) => <StoryLine ed={ed} line={line} />)}
              </ul>
            </section>
          ))}
        </section>
      ))}
    </section>
  )}

  {model.withoutName.length > 0 && (
    <section class="stories-part" id={STORIES_ANCHORS.withoutName} aria-labelledby={`${STORIES_ANCHORS.withoutName}-h`}>
      <h2 id={`${STORIES_ANCHORS.withoutName}-h`}>{t("index.withoutName")}</h2>
      <p class="stories-lead">{t("index.withoutNameLead")}</p>
      <ul class="story-lines" role="list">
        {model.withoutName.map((line) => <StoryLine ed={ed} line={line} />)}
      </ul>
    </section>
  )}
</Base>
