---
/**
 * The title page, שער (concept-quiet §5.1, tech-quiet §2 `/{ed}/`): what this is, and the three ways
 * in. The name and one sentence; "this week" (parsha and nearest zman, built for the days around the
 * build and showing the visitor's own day with script);
 * the contents in brief (sections with counts); the indexes, one line each, in the order of
 * concept-quiet-corpus C5 with counts from the corpus layer (anchor `#indexes`, the target of the
 * "Indexes" nav item); and the standing coverage line. No featured, popular or recently added.
 */
import Base from "../../layouts/Base.astro";
import ThisWeek from "../../components/catalog/ThisWeek.astro";
import { loadCatalogCorpus } from "../../components/catalog/corpus.ts";
import IndexesBlock from "../../components/corpus/IndexesBlock.astro";
import { quietLayer } from "../../components/corpus/layer.ts";
import { indexesBlock } from "../../components/corpus/model.ts";
import { buildDate, contentsHref, contentsModel, corpusTotals, pocketGuideUrl, sectionHref, thisWeekWindow } from "../../components/catalog/model.ts";
import { catalogSlot, useCatalogT } from "../../components/catalog/strings.ts";
import NewTabLink from "../../components/NewTabLink.astro";
import { currentSiteEnv } from "../../components/seo/site-env.ts";
import { runAttrs } from "../../lib/bidi.ts";
import { EDS, type Ed } from "../../lib/edition.ts";
import { useT } from "../../i18n/index.ts";

export function getStaticPaths() {
  return EDS.map((ed) => ({ params: { ed } }));
}

const ed = Astro.params.ed as Ed;
const corpus = loadCatalogCorpus();
const t = useT(ed);
const c = useCatalogT(ed);
const totals = corpusTotals(corpus);
const contents = contentsModel(corpus, ed);
const week = thisWeekWindow(corpus, ed, buildDate(process.env));
// Guide sections by name; the uncatalogued ones (whose titles repeat the guide's) as one line.
const sections = [...contents.yiddish, ...contents.english];
const uncataloguedCount = contents.uncatalogued.reduce((a, s) => a + s.count, 0);

// The index pages this build has (`<dir>/index.astro` beside this page): a line whose page is not
// built yet is left out rather than linked to a 404.
const builtDirs = new Set(
  Object.keys(import.meta.glob("./*/index.astro")).map((f) => f.split("/").at(-2) ?? ""),
);
const layer = quietLayer();
// The Live site's home in this edition, opened in a new tab; the lead's `{link}` is the link.
const liveHome = currentSiteEnv().links.live.home(ed);
const [liveBefore, liveAfter] = catalogSlot(ed, "home.liveLead", "link");
const [leadBefore, leadAfter] = catalogSlot(ed, "home.lead", "guide");
const indexLines = indexesBlock(ed, layer.counts, (href) => builtDirs.has(href.split("/")[2] ?? ""));
---
<Base ed={ed} title={t("site.name")}>
  <header class="title-page">
    <h1>{t("site.name")}</h1>
    <p class="title-lead">{leadBefore}<NewTabLink ed={ed} href={pocketGuideUrl(corpus)}>{c("guide.link")}</NewTabLink>{leadAfter}</p>
    <p class="standing" data-coverage>
      {c("home.standing", { total: totals.total, hours: totals.hoursAbout, full: totals.full })}
    </p>
    <p class="live-lead" data-print="hide">
      {liveBefore}<NewTabLink ed={ed} href={liveHome} hreflang={ed}>{c("home.liveLink")}</NewTabLink>{liveAfter}
    </p>
  </header>

  <ThisWeek ed={ed} week={week} />

  <section class="brief" aria-labelledby="contents-brief">
    <h2 id="contents-brief">{c("home.contents")}</h2>
    <ul role="list" class="brief-list">
      {sections.map((s) => (
        <li data-section={s.key}>
          <a href={sectionHref(ed, s)}><bdi {...runAttrs(s.title, s.lang)}>{s.title}</bdi></a>
          <span class="sep" aria-hidden="true"> · </span>
          <span class="count">{c("count.shiurim", { count: s.count })}</span>
        </li>
      ))}
      {uncataloguedCount > 0 && (
        <li data-section="uncatalogued">
          <a href={`${contentsHref(ed)}#uncatalogued`}>{c("contents.uncatalogued")}</a>
          <span class="sep" aria-hidden="true"> · </span>
          <span class="count">{c("count.shiurim", { count: uncataloguedCount })}</span>
        </li>
      )}
    </ul>
    <p><a href={contentsHref(ed)}>{c("home.contentsAll")}</a></p>
  </section>

  <IndexesBlock ed={ed} heading={c("home.indexes")} lines={indexLines} visibleShiurim={layer.visibleShiurim} />
</Base>

<style>
  .title-page > * + * {
    margin-block-start: var(--space-s);
  }

  .title-page h1 {
    font-size: var(--step-5);
  }

  .title-lead {
    font-size: var(--step-2);
  }

  .live-lead {
    font-size: var(--step-1);
  }

  .standing {
    font-size: var(--step-0);
    color: var(--color-ink-muted);
  }

  .brief > * + * {
    margin-block-start: var(--space-s);
  }

  .brief-list {
    columns: 2 16rem;
    column-gap: var(--space-xl);
    font-size: var(--step-0);
  }

  .brief-list li {
    break-inside: avoid;
    padding-block: var(--space-3xs);
  }

  .count,
  .sep {
    color: var(--color-ink-muted);
  }
</style>
