---
/**
 * Not found (`dist/404.html`, served for every unknown address by `not_found_handling: "404-page"`
 * in wrangler.jsonc). One page for every edition, laid out like the root chooser (`CHOOSER_ORDER`:
 * the right-to-left editions on the right, English on the left), each with a link to its edition's
 * home. Never indexed.
 */
import "../styles/fonts.css";
import "@emunas/tokens/tokens.css";
import "../styles/quiet.css";
import "../styles/print.css";
import { formatQuiet } from "@emunas/links";
import { useT } from "../i18n/index.ts";
import { CHOOSER_ORDER, dirOf, type Ed } from "../lib/edition.ts";
import Seo from "../components/seo/Seo.astro";
import Dedication from "../components/Dedication.astro";
import ThemeHead from "../components/ThemeHead.astro";

const TEXT: Readonly<Record<Ed, { readonly title: string; readonly lead: string }>> = {
  en: { title: "Page not found", lead: "There is no page at this address." },
  yi: { title: "דער בלאט איז נישט געפונען", lead: "ביי דער אדרעס איז נישטא קיין בלאט." },
  he: { title: "הדף לא נמצא", lead: "אין דף בכתובת זו." },
};
const en = useT("en");
const editions = CHOOSER_ORDER.map((ed) => ({ ed, dir: dirOf(ed), text: TEXT[ed], siteName: useT(ed)("site.name"), home: formatQuiet({ kind: "home", ed }) }));
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <ThemeHead />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${TEXT.en.title} · ${en("site.name")}`}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Seo path="/404.html" title={TEXT.en.title} description={TEXT.en.lead} siteName={en("site.name")} noindex />
  </head>
  <body>
    <main id="main">
      <h1 class="visually-hidden">{TEXT.en.title}</h1>
      <div class="chooser" dir="rtl">
        {editions.map(({ ed, dir, text, siteName, home }) => (
          <section lang={ed} dir={dir} aria-labelledby={`not-found-${ed}`}>
            <h2 id={`not-found-${ed}`}>{text.title}</h2>
            <p>{text.lead}</p>
            <p><a href={home}>{siteName}</a></p>
          </section>
        ))}
      </div>
    </main>
    <footer class="site-footer">
      <Dedication />
    </footer>
  </body>
</html>
