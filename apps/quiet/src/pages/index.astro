---
/**
 * The root: every edition side by side, the right-to-left editions (Yiddish, Hebrew) on the right
 * and English on the left (concept-quiet §8, integration-plan C20; `CHOOSER_ORDER`). Static, no
 * redirect, remembers nothing.
 */
import "../styles/fonts.css";
import "@emunas/tokens/tokens.css";
import "../styles/quiet.css";
import "../styles/print.css";
import { formatQuiet } from "@emunas/links";
import { useT } from "../i18n/index.ts";
import { CHOOSER_ORDER, dirOf } from "../lib/edition.ts";
import Seo from "../components/seo/Seo.astro";
import Dedication from "../components/Dedication.astro";
import ThemeHead from "../components/ThemeHead.astro";

const en = useT("en");
const editions = CHOOSER_ORDER.map((ed) => ({ ed, dir: dirOf(ed), t: useT(ed), home: formatQuiet({ kind: "home", ed }), about: formatQuiet({ kind: "index", ed, index: "about" }) }));
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <ThemeHead />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{en("site.name")}</title>
    <meta name="description" content={en("site.description")} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Seo path="/" title={en("site.name")} description={en("site.description")} siteName={en("site.name")} />
  </head>
  <body>
    <main id="main">
      <h1 class="visually-hidden">{en("chooser.title")}</h1>
      <div class="chooser" dir="rtl">
        {editions.map(({ ed, dir, t, home, about }) => (
          <section lang={ed} dir={dir} aria-labelledby={`chooser-${ed}`}>
            <h2 id={`chooser-${ed}`}><a href={home}>{t("site.name")}</a></h2>
            <p>{t("site.description")}</p>
            <p><a href={home}>{t("chooser.enter")}</a> · {t("chooser.enterNote")}</p>
            <p><a href={about}>{t("nav.about")}</a></p>
          </section>
        ))}
      </div>
    </main>
    <footer class="site-footer">
      <Dedication />
    </footer>
  </body>
</html>
