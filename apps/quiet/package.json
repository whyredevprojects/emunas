{
  "name": "@emunas/quiet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && tsx scripts/build-search.ts",
    "preview": "astro preview",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json && ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "fonts:sync": "tsx src/lib/fonts-sync.ts",
    "search:build": "tsx scripts/build-search.ts"
  },
  "dependencies": {
    "@emunas/corpus": "0.0.0",
    "@emunas/i18n": "0.0.0",
    "@emunas/links": "0.0.0",
    "@emunas/search-core": "0.0.0",
    "@emunas/tokens": "0.0.0",
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@emunas/config": "0.0.0",
    "@emunas/corpus-guard": "0.0.0",
    "@types/node": "26.6.6",
    "axe-core": "4.14.0",
    "pagefind": "1.5.2",
    "playwright-core": "1.64.1",
    "stylelint": "17.16.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
