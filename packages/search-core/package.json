{
  "name": "@emunas/search-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The indexed-field allow-list (SearchDoc per shiur, MomentRow per moment) and query normalization shared by Pagefind (Quiet), MiniSearch (Live) and the emunas-api Worker (integration-plan C9, C19, W2.2).",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./build": "./src/build/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "search:build": "tsx src/build/cli.ts"
  },
  "dependencies": {
    "@emunas/corpus": "0.0.0",
    "@emunas/normalize": "0.0.0"
  },
  "devDependencies": {
    "@emunas/config": "0.0.0",
    "@emunas/corpus-guard": "0.0.0",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
