{
  "name": "@emunas/tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared design primitives for both sites: CSS custom properties (type scale, spacing, radii, colour roles light/dark) and self-hosted subset woff2 fonts (Hebrew + Latin, all OFL).",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./css/tokens.css",
    "./fonts.css": "./css/fonts.css",
    "./fonts/*": "./fonts/*",
    "./manifest.json": "./fonts/manifest.json",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@emunas/i18n": "0.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "css": "tsx scripts/build-css.ts",
    "fonts:subset": "python3 -I scripts/subset_fonts.py && tsx scripts/build-css.ts"
  },
  "devDependencies": {
    "@emunas/config": "0.0.0",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
