{
  "name": "@emunas/corpus-guard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Leak guard for both sites: forbidden keys and substrings, verbatim n-gram scan against the ASR transcripts, pre-pass suppression list, Pagefind record checker, budget helpers (integration-plan §5.3).",
  "exports": {
    ".": "./src/index.ts",
    "./tokenize": "./src/tokenize.ts",
    "./pagefind": "./src/pagefind.ts",
    "./budgets": "./src/budgets.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "guard": "tsx src/cli.ts",
    "bench:real": "tsx bench/real-prepass.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@emunas/config": "0.0.0",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
