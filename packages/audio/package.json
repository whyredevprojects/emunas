{
  "name": "@emunas/audio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Audio URL scheme, the /audio/<id>.mp3 edge handler (Range/HEAD/conditional), the audio table, and the audio-publish CLI (private bucket emunas -> emunas-audio).",
  "exports": {
    ".": "./src/index.ts",
    "./paths": "./src/paths.ts",
    "./table": "./src/table.ts",
    "./handler": "./src/handler.ts",
    "./publish": "./src/publish/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json && node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.workers.config.ts",
    "test:node": "vitest run --config vitest.config.ts",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "audio:publish": "tsx src/publish/cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1159.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@cloudflare/workers-types": "5.20261031.1",
    "@emunas/config": "0.0.0",
    "@types/node": "26.6.6",
    "vitest": "5.0.5"
  }
}
